---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import WorkCard from '../components/WorkCard.astro';
import Highlight from '../components/Highlight.astro';
import Footer from '../components/Footer.astro';
import { getWork, slugOf } from '../lib/work';
import { t } from '../i18n/ui';

const lang = 'en' as const;
const work = await getWork(lang);
---

<Base lang={lang} title="Shaw X — engineer with taste" description={t(lang, 'hero.intro')}>
  <Nav lang={lang} />
  <Hero lang={lang} />
  <section id="work" class="container work-section">
    <p class="section-label">{t(lang, 'work.label')} <span class="idx">/01</span></p>
    <div class="work-grid">
      {
        work.map((e, i) => (
          <WorkCard
            title={e.data.title}
            summary={e.data.summary}
            stack={e.data.stack}
            href={`/work/${slugOf(e)}/`}
            index={i + 1}
            lang={lang}
          />
        ))
      }
    </div>
  </section>
  <Highlight lang={lang} />
  <Footer lang={lang} />
  <script>
    import { initSite } from '../scripts/scroll-fx';
    initSite();
  </script>
</Base>

<style>
  .work-section { padding-top: 90px; }
  .work-grid {
    margin-top: 26px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
  }
</style>
