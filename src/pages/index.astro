---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Galaxy from '../components/Galaxy.astro';
import Highlight from '../components/Highlight.astro';
import Footer from '../components/Footer.astro';
import { getWork } from '../lib/work';
import { t } from '../i18n/ui';

const lang = 'en' as const;
const work = await getWork(lang);
---

<Base lang={lang} title="Shaw X — engineer with taste" description={t(lang, 'hero.intro')}>
  <Nav lang={lang} />
  <Hero lang={lang} />
  <section id="work" class="container work-section">
    <p class="section-label">{t(lang, 'work.label')} <span class="idx">/01</span></p>
    <Galaxy
      lang={lang}
      items={work.map((e) => ({
        title: e.data.title,
        cover: e.data.cover ?? '/covers/taxglobal.svg',
        link: e.data.link,
      }))}
    />
  </section>
  <Highlight lang={lang} />
  <Footer lang={lang} />
  <script>
    import { initSite } from '../scripts/scroll-fx';
    initSite();
  </script>
</Base>

<style>
  .work-section { padding-top: 90px; }
</style>
