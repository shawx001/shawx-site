---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import WorkList from '../components/WorkList.astro';
import Highlight from '../components/Highlight.astro';
import Footer from '../components/Footer.astro';
import { getWork } from '../lib/work';
import { t } from '../i18n/ui';

const lang = 'en' as const;
const work = await getWork(lang);
---

<Base lang={lang} title="Shaw X — AI-native coder & designer" description={t(lang, 'hero.intro')}>
  <Nav lang={lang} />
  <Hero lang={lang} />
  <div class="sky">
    <section id="work">
      <div class="container work-section">
        <p class="section-label">{t(lang, 'work.label')} <span class="idx">/01</span></p>
        <WorkList
          lang={lang}
          items={work.map((e) => ({
            title: e.data.title,
            summary: e.data.summary,
            link: e.data.link,
            casePath: e.data.casePath,
          }))}
        />
      </div>
    </section>
    <Highlight lang={lang} />
    <Footer lang={lang} />
  </div>
  <script>
    import { initSite } from '../scripts/scroll-fx';
    initSite();
  </script>
</Base>

<style>
  .sky {
    background:
      linear-gradient(rgba(26, 17, 46, 0.55), rgba(26, 17, 46, 0.55)),
      url('/bg/dusk.jpg') center / cover no-repeat;
    background-attachment: fixed;
    --wl-line: rgba(245, 239, 228, 0.28);
    --wl-title: #F5EFE4;
    --wl-muted: rgba(240, 234, 248, 0.75);
    --wl-accent: #F0937A;
    --ft-title: #F5EFE4;
    --ft-muted: rgba(240, 234, 248, 0.7);
    --ft-line: rgba(245, 239, 228, 0.25);
    --ft-accent: #F0937A;
  }
  #work { padding: 230px 0 120px; }
  .sky .section-label { color: rgba(240, 234, 248, 0.72); }
  .sky .section-label .idx { color: #F0937A; }
  @media (hover: none) {
    .sky { background-attachment: scroll; }
  }
</style>
