---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import WorkList from '../../components/WorkList.astro';
import Highlight from '../../components/Highlight.astro';
import Footer from '../../components/Footer.astro';
import { getWork } from '../../lib/work';
import { t } from '../../i18n/ui';

const lang = 'zh' as const;
const work = await getWork(lang);
---

<Base lang={lang} title="Shaw X — 有审美的独立工程师" description={t(lang, 'hero.intro')}>
  <Nav lang={lang} />
  <Hero lang={lang} />
  <section id="work" class="work-band">
    <div class="container work-section">
      <p class="section-label">{t(lang, 'work.label')} <span class="idx">/01</span></p>
      <WorkList
        lang={lang}
        items={work.map((e) => ({
          title: e.data.title,
          summary: e.data.summary,
          cover: e.data.cover ?? '/covers/taxglobal.svg',
          link: e.data.link,
        }))}
      />
    </div>
  </section>
  <Highlight lang={lang} />
  <Footer lang={lang} />
  <script>
    import { initSite } from '../../scripts/scroll-fx';
    initSite();
  </script>
</Base>

<style>
  .work-band {
    margin-top: 90px;
    padding: 96px 0 120px;
    background:
      linear-gradient(rgba(26, 17, 46, 0.55), rgba(26, 17, 46, 0.55)),
      url('/bg/dusk.jpg') center / cover no-repeat;
    background-attachment: fixed;
    --wl-line: rgba(245, 239, 228, 0.28);
    --wl-title: #F5EFE4;
    --wl-muted: rgba(240, 234, 248, 0.75);
    --wl-accent: #F0937A;
  }
  .work-band .section-label { color: rgba(240, 234, 248, 0.72); }
  .work-band .section-label .idx { color: #F0937A; }
  @media (hover: none) {
    .work-band { background-attachment: scroll; }
  }
</style>
