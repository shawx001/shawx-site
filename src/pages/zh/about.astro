---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { t } from '../../i18n/ui';

const lang = 'zh' as const;
const skills = ['AI Agent', 'LLM 编排', 'Python', 'TypeScript', '产品设计', '审查门禁'];
---

<Base lang={lang} title="关于 — Shaw X" description="有审美、有 product sense 的独立工程师。">
  <Nav lang={lang} />
  <main class="container about">
    <p class="section-label">{t(lang, 'about.title')} <span class="idx">/02</span></p>
    <div class="grid">
      <div class="photo" aria-hidden="true">
        {/* TODO(验收后): 换成 Shaw 的照片 */}
        <img src="/favicon.svg" alt="" width="64" height="64" />
        <span class="mono">photo soon</span>
      </div>
      <div class="bio">
        <h1>Shaw X</h1>
        <p>
          我是 Shaw —— 一个既在乎数字对不对、也在乎产品摸起来什么感觉的独立工程师。我从零到一构建
          AI 产品:架构、产品决策、像素细节,以及让一切保持诚实的审查门禁。
        </p>
        <p>
          现在我在做 TaxGlobal AI —— 一个规则引擎是唯一真相、LLM 永远不许猜的报税助手。2026
          年,我在 Mithra 限时 CRM 构建挑战中拿到全球第 2。
        </p>
        <h2 class="sub mono">技能</h2>
        <div class="tags">
          {skills.map((s) => <span class="tag mono">{s}</span>)}
        </div>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .about { padding: 130px 24px 40px; }
  .grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 48px;
    margin-top: 30px;
  }
  @media (max-width: 768px) {
    .grid { grid-template-columns: 1fr; }
  }
  .photo {
    background: var(--card);
    border-radius: 12px;
    aspect-ratio: 4 / 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }
  .photo span { font-size: 11px; color: var(--card-ink-2); letter-spacing: 0.14em; }
  .bio h1 { font-size: clamp(40px, 6vw, 64px); }
  .bio p { color: var(--ink); max-width: 560px; }
  .sub {
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 36px;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .tag {
    font-size: 12px;
    color: var(--ink-2);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 4px 12px;
  }
</style>
