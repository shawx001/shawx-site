---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { t } from '../../i18n/ui';

const lang = 'zh' as const;
const skills = ['AI Agent', 'LLM 编排', 'Python', 'TypeScript', '产品设计', '审查门禁'];
---

<Base lang={lang} title="关于 — Shaw X" description="有审美、有 product sense 的独立工程师。">
  <Nav lang={lang} />
  <main class="container about">
    <p class="section-label">{t(lang, 'about.title')} <span class="idx">/02</span></p>
    <div class="grid">
      <img class="photo-img" src="/about/portrait.jpg" alt="Shaw" />
      <div class="bio">
        <h1>Shaw X</h1>
        <p>
          我是 Shaw —— 一个路子很宽的独立工程师:架构、产品决策、像素细节,以及让一切保持诚实的审查门禁。
          对"怎么做"我有自己的想法,对"好不好看"我的想法更多。
        </p>
        <p>
          现在我在做 TaxGlobal AI —— 一个规则引擎是唯一真相、LLM 永远不许猜的报税助手。2026
          年,我在 Mithra 限时 CRM 构建挑战中拿到全球第 2。
        </p>
        <p>
          艺术是我的另一个家。我的色彩、节奏和克制感都来自那里 ——
          我收集一切有审美的东西,也试着以同样的标准交付作品。
        </p>
        <div class="art-row">
          <img src="/about/roses-1.jpg" alt="窗边暖光下的玫瑰,Shaw 摄" loading="lazy" />
          <img src="/about/roses-2.jpg" alt="逆光中的玫瑰,Shaw 摄" loading="lazy" />
        </div>
        <h2 class="sub mono">技能</h2>
        <div class="tags">
          {skills.map((s) => <span class="tag mono">{s}</span>)}
        </div>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .about { padding: 130px 24px 40px; }
  .grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 48px;
    margin-top: 30px;
  }
  @media (max-width: 768px) {
    .grid { grid-template-columns: 1fr; }
  }
  .photo-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 12px;
  }
  .art-row {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 12px;
    margin-top: 18px;
    max-width: 560px;
  }
  .art-row img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 10px;
  }
  .bio h1 { font-size: clamp(40px, 6vw, 64px); }
  .bio p { color: var(--ink); max-width: 560px; }
  .sub {
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 36px;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .tag {
    font-size: 12px;
    color: var(--ink-2);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 4px 12px;
  }
</style>
