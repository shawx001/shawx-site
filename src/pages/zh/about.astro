---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { t } from '../../i18n/ui';

const lang = 'zh' as const;
const skills = ['AI Agent', 'LLM 编排', 'Python', 'TypeScript', '产品设计', '审查门禁'];
---

<Base lang={lang} title="关于 — Shaw X" description="AI 原生的工程师与设计师，横跨品牌与创意产品。">
  <Nav lang={lang} />
  <main class="container about">
    <p class="section-label">{t(lang, 'about.title')} <span class="idx">/02</span></p>
    <div class="grid">
      <img class="photo-img" src="/about/portrait-about.jpg" alt="Shaw" />
      <div class="bio">
        <h1>Shaw X</h1>
        <p>
          "X"是一个交叉点。不是变量——是两条线相遇的地方，也是新事物出现的地方。
        </p>
        <p>
          我在中国长大，从小就同时磨砺两种直觉：一件东西是怎么做出来的，以及它值不值得被凝视。
          这两者我一直都没有放下。我相信最扎实的作品诞生在边界处——工程的严密与设计的克制，从两个方向逼近同一个答案。
        </p>
        <p>
          我写代码，因为精准是一种尊重。我做设计，因为审美不是装饰——它是判断力的显形。
          这两者并不矛盾——它们是同一种要求，用不同的语言说出来。
        </p>
        <p>
          艺术是我校准自己的方式。我拍照、收藏用心做的东西，让美保持对我真实。
          那种对色彩、节奏与克制的感知，渗透在我交付的每一件作品里。
        </p>
        <p>X 是我工作的地方。</p>
        <div class="art-row">
          <img src="/about/art-1.jpg" alt="暗调里的玫瑰,Shaw 摄" loading="lazy" />
          <img src="/about/art-3.jpg" alt="逆光中的玫瑰,Shaw 摄" loading="lazy" />
          <img src="/about/art-2.jpg" alt="暖墙光影下的玫瑰,Shaw 摄" loading="lazy" />
        </div>
        <h2 class="sub mono">技能</h2>
        <div class="tags">
          {skills.map((s) => <span class="tag mono">{s}</span>)}
        </div>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .about { padding: 130px 24px 40px; }
  .grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 48px;
    margin-top: 30px;
  }
  @media (max-width: 768px) {
    .grid { grid-template-columns: 1fr; }
  }
  .photo-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 12px;
  }
  .art-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 18px;
    max-width: 640px;
  }
  .art-row img {
    width: 100%;
    height: 210px;
    object-fit: cover;
    border-radius: 10px;
  }
  @media (max-width: 600px) {
    .art-row { grid-template-columns: 1fr; }
    .art-row img { height: 200px; }
  }
  .bio h1 { font-size: clamp(40px, 6vw, 64px); }
  .bio p { color: var(--ink); max-width: 560px; }
  .sub {
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 36px;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .tag {
    font-size: 12px;
    color: var(--ink-2);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 4px 12px;
  }
</style>
