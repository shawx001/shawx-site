---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import VeriuboBenchCharts from '../../../components/VeriuboBenchCharts.astro';

const lang = 'zh' as const;
---

<Base
  lang={lang}
  title="VeriUBO — Shaw X"
  description="企业客户尽调 AI 工作台 —— 九项 FATF 合规门禁、循环股权穿透、OFAC 50% Rule 与零泄露客户补件门户。"
>
  <Nav lang={lang} />
  <main class="container case">
    <a class="back mono" href="/zh/#work">← 精选作品</a>

    <header class="head">
      <h1>VeriUBO</h1>
      <p class="zh-name mono">企业客户尽调工作台</p>
      <p class="lede">
        面向银行企业开户尽调（KYB）的 AI 合规工作台 —— 九项 FATF 门禁、多层与循环股权穿透、OFAC 50% Rule 归集与零泄露客户补件门户。
      </p>
      <a class="try-live" href="https://github.com/shawx001/VeriUBO" target="_blank" rel="noopener">
        查看 GitHub 源码 <span class="tl-arrow">↗</span>
      </a>
    </header>

    <div class="meta">
      <div class="meta-item">
        <span class="meta-label mono">Context</span>
        <span class="meta-value">独立产品<br />2026 · v2.1 已交付</span>
      </div>
      <div class="meta-item">
        <span class="meta-label mono">My role</span>
        <span class="meta-value">主创 —— 产品、<br />交互设计、系统架构</span>
      </div>
      <div class="meta-item">
        <span class="meta-label mono">Status</span>
        <span class="meta-value">开源原型已运行<br />本机 LLM + 实时名单</span>
      </div>
    </div>

    <div class="shot dark">
      <figure class="screen-frame">
        <img
          src="/case/veriubo/dossier.png"
          alt="VeriUBO 极简尽调卷宗工作台界面：左侧收口呈现九项 FATF 尽调门禁与待处理清单，主区进行实时制裁名单人工处置与防矛盾护栏校验"
          width="1440"
          height="900"
        />
      </figure>
      <p class="shot-cap mono">极简尽调卷宗工作台 —— 九项 FATF 门禁、待办收口与实时制裁处置</p>
    </div>

    <section class="block">
      <p class="b-label mono">01 — 概览</p>
      <h2>AI 负责调查，规则引擎负责裁决。</h2>
      <p>
        企业银行开户尽调容不得含糊：穿透多层与循环持股后究竟谁控制公司、制裁名单别名命中究竟是同名误报还是风险主体、批准之后登记发生变更该如何追责重审。VeriUBO 让本机 Agent 专注后台调查、补件跟进与待办推送，同时把所有股权求解、期限规则与审批阻断留在后端确定性执行。
      </p>
      <p>
        在旗舰案例中，把 <strong>James Chen</strong>（12.5%）与 <strong>J. Chen</strong>（14%）合并为同一自然人后，有效持股跨过 25% 受益所有人门槛达到 <strong>26.5%</strong>，系统立即将其自动写入必核身份清单；即便已排除他的模拟制裁别名误报，只要独立身份材料未补齐，高级审批仍会触发服务端 <strong>HTTP 409</strong> 硬阻断。
      </p>
    </section>

    <section class="block">
      <p class="b-label mono">02 — 它怎么工作</p>
      <h2>三个角色，一条确定性主干。</h2>
      <div
        class="pipeline"
        role="img"
        aria-label="产品流程：客户补件端提交脱敏资料，确定性内核与后台 Agent 执行股权计算、OFAC 归集与查册，经办分析员与独立高级审批官完成核验签批"
      >
        <div class="p-flow">
          <div class="p-step">
            <span class="p-name mono">客户补件端</span>
            <span class="p-desc">零泄露自助补件：经营档案、股权文件与证件上传</span>
          </div>
          <span class="p-arrow" aria-hidden="true">→</span>
          <div class="p-step p-core">
            <span class="p-name mono">确定性内核 + Agent</span>
            <span class="p-desc">Leontief 股权求解、OFAC 50% 归集、GLEIF 查册与待办推送</span>
          </div>
          <span class="p-arrow" aria-hidden="true">→</span>
          <div class="p-step">
            <span class="p-name mono">分析员 &amp; 审批官</span>
            <span class="p-desc">极简卷宗核验、独立四眼签批与按版本归档导出</span>
          </div>
        </div>
        <p class="p-gate mono">批准之后若外部登记发生变更 —— 案件自动重开进入重审</p>
      </div>
    </section>

    <section class="block">
      <p class="b-label mono">03 — 三个角色，三种视角</p>
      <h2>同一个案件，每个角色只看到自己该看的部分。</h2>
      <div class="roles">
        <figure class="role">
          <a class="role-shot" href="/case/veriubo/role-analyst.png" target="_blank" rel="noopener">
            <img src="/case/veriubo/role-analyst.png" alt="经办分析员视角：按优先级排列的尽调待办队列，展示每个案件的阻断项与建议下一步" width="1024" height="728" loading="lazy" />
          </a>
          <figcaption>
            <span class="role-tag mono">经办分析员</span>
            <h3>处理待办队列</h3>
            <p>看到按风险排序的案件、未解除的阻断项和 Agent 建议的下一步；负责调查、处置名单命中并提交审批。</p>
          </figcaption>
        </figure>
        <figure class="role">
          <a class="role-shot" href="/case/veriubo/role-approver.png" target="_blank" rel="noopener">
            <img src="/case/veriubo/role-approver.png" alt="独立高级审批官视角：签批弹窗，包含九项核验状态快照、批准/升级复核/拒绝三种决定与服务端阻断提示" width="1024" height="640" loading="lazy" />
          </a>
          <figcaption>
            <span class="role-tag mono">独立高级审批官</span>
            <h3>独立签批</h3>
            <p>针对案件某一版本的固定快照做决定；经办人本人提交的签批会被服务端直接拒绝。</p>
          </figcaption>
        </figure>
        <figure class="role">
          <a class="role-shot" href="/case/veriubo/role-client.png" target="_blank" rel="noopener">
            <img src="/case/veriubo/role-client.png" alt="客户补件端视角：待补材料清单、自动预检反馈与提交回执，不显示任何内部风控信息" width="1024" height="728" loading="lazy" />
          </a>
          <figcaption>
            <span class="role-tag mono">客户补件端</span>
            <h3>自己补齐材料</h3>
            <p>只看到还缺哪些文件、上传的文件为什么没通过预检；看不到制裁命中、风险评级和审核备注。</p>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="block">
      <p class="b-label mono">04 — 核心能力</p>
      <h2>为真实审计而设计的四件事。</h2>

      <div class="feature">
        <div class="f-text">
          <h3>多层与循环股权穿透</h3>
          <p>
            交叉持股会让朴素的递归脚本陷入死循环。三栏多模态股权取证视图将原始 PDF 标注与 300 DPI 切片、
            Leontief 线性代数持股图谱和人工同名归并放在同一画布 —— 合并同名股东的瞬间，穿透比例与必核人员清单同步重算。
          </p>
        </div>
        <figure class="f-visual screen-card">
          <img
            src="/case/veriubo/ownership.png"
            alt="VeriUBO 三栏多模态股权穿透取证视图：左侧原始 PDF 切片标注，中间 Leontief 循环持股图谱，右侧同名冲突人工确认与实体合并"
            width="1440"
            height="900"
            loading="lazy"
          />
        </figure>
      </div>

      <div class="feature flip">
        <div class="f-text">
          <h3>OFAC 50% Rule 双口径归集</h3>
          <p>
            按照 OFAC FAQ 401 规则，经济持股与受制裁控制比例并不是同一个数字。若受制裁主体持有控股公司 50%，控股公司再持有申请企业 50%，去重后的经济受益股权只有 25%，但受制裁级联控制比例已达 50%，必须阻断。系统并行计算并同时呈现两套口径。
          </p>
        </div>
        <div class="f-visual">
          <div class="receipt">
            <p class="r-title mono">OFAC FAQ 401 · 双口径核查</p>
            <div class="r-row">
              <span>受制裁股东 → 控股公司</span>
              <span class="mono">50.0%</span>
            </div>
            <div class="r-row">
              <span>控股公司 → 申请企业</span>
              <span class="mono">50.0%</span>
            </div>
            <div class="r-row">
              <span>去重后经济持股（Leontief）</span>
              <span class="mono">25.0%</span>
            </div>
            <div class="r-row accent">
              <span>OFAC 级联受制裁控制</span>
              <span class="mono">50.0% · 触发阻断</span>
            </div>
            <p class="r-cap mono">基于 19,629 条公开 OFAC SDN 名单本地实时筛查</p>
          </div>
        </div>
      </div>

      <div class="feature">
        <div class="f-text">
          <h3>零泄露客户自助补件</h3>
          <p>
            审核人员大量时间耗在邮件催单，却绝不能把内部制裁预警或高风险标记泄露给客户。切换至客户补件端后，外部申请人只看到经脱敏裁剪的缺件清单与结构化经营档案表单，提交后直接回流至经办人的待复核队列。
          </p>
        </div>
        <figure class="f-visual screen-card">
          <img
            src="/case/veriubo/client-portal.png"
            alt="VeriUBO 零泄露客户补件门户界面：客户可自助补充结构化企业经营信息并上传缺失材料，无法接触任何内部风控与制裁记录"
            width="1440"
            height="900"
            loading="lazy"
          />
        </figure>
      </div>

      <div class="feature flip">
        <div class="f-text">
          <h3>独立四眼审批与防矛盾护栏</h3>
          <p>
            服务端强制审批人与经办分析员相互独立；在名单处置或审批框中切换结论时，系统自动清空旧备注并要求重新确认一致的理由，杜绝导出的审计卷宗里出现“决定为拒绝、理由却写着升级复核”的矛盾记录。
          </p>
        </div>
        <div class="f-visual">
          <div class="escalate">
            <p class="fc-head mono">服务端拦截 · HTTP 409</p>
            <p class="e-line">
              必核受益所有人 <strong>James Chen（26.5%）</strong> 尚缺独立身份核验记录，且最终签批必须由与经办人不同的独立高级审批官完成。
            </p>
            <div class="e-chips">
              <span class="e-chip mono">审批已阻断 · 409</span>
              <span class="e-chip muted mono">四眼独立性校验</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="block">
      <p class="b-label mono">05 — 后训练与评测方案</p>
      <h2>面向单卡 16 GB 设计的微调与强化学习路线。</h2>
      <p>
        零样本多模态模型在扫描模糊的股权文件上极易出错：红章遮挡下的 <code>0/O</code> 与 <code>3/8</code> 误读、跨页表格错行、无依据编造以及同名股东误合并。与其把敏感企业 KYC 扫描件发往云端 API，VeriUBO 设计了一套可在单张 <strong>RTX 5080（16 GB）</strong> 上落地的四阶段本地后训练方案，同时将推理峰值控制在 <strong>12.5 GB 显存</strong>以内。
      </p>

      <div class="pt-grid">
        <div class="pt-card">
          <span class="g-num mono">阶段 01 · &lt; 6 GB 显存</span>
          <h3>PP-OCRv4 识别头微调</h3>
          <p>冻结检测网络，仅微调识别尾部与 CTC/NRTR 预测头，专攻盖章重叠、倾斜模糊下的数字与小数点，并输出逐字符香农熵以触发 300 DPI 局部放大复核。</p>
        </div>
        <div class="pt-card">
          <span class="g-num mono">阶段 02 · 4-bit NF4</span>
          <h3>Qwen2.5-VL-7B QLoRA SFT</h3>
          <p>采用 4-bit NF4 量化底座 + <code>bf16</code> 计算与仅助手 token 掩码，在带坐标框的多轮结构化抽取及 <code>crop_and_inspect(dpi=300)</code> 工具调用轨迹上做监督微调。</p>
        </div>
        <div class="pt-card">
          <span class="g-num mono">阶段 03 · 偏好对齐 / RL</span>
          <h3>校验器引导的非对称风险 DPO</h3>
          <p>由符号 Leontief 校验器自动挖掘难负样本，对“静默编造”和“同名误合并”施加远高于保守拒识的非对称惩罚；同时预留 <code>verl</code> GRPO 奖励函数接口用于多卡强化学习。</p>
        </div>
        <div class="pt-card">
          <span class="g-num mono">阶段 04 · 风险校准</span>
          <h3>Conformal Risk Control 门控</h3>
          <p>在显式误合并上限 <code>α ≤ 1%</code> 约束下校准直通率（STP），让高不确定度图谱自动分流给人工分析员，而不是悄悄放行。</p>
        </div>
      </div>

      <VeriuboBenchCharts lang={lang} />

      <div class="bench-card">
        <div class="bench-head">
          <div>
            <p class="r-title mono">UBO-Bench v1.0 · 分层消融对比</p>
            <p class="bench-sub mono">240 份零泄漏合成测试集（客户家族 × 模板家族双隔离）+ 40 份公开 OOD（22 份 UKCH · 18 份 SEC EDGAR）</p>
          </div>
        </div>

        <div class="table-wrap">
          <table class="bench-table">
            <thead>
              <tr>
                <th>阶段 / 模型配置</th>
                <th class="num">股权抽取 F1</th>
                <th class="num">UBO 召回率</th>
                <th class="num">误合并率</th>
                <th class="num">STP（α≤1%）</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Qwen2.5-VL-7B（零样本基线）<span class="v-tag mono">Baseline</span></td>
                <td class="num mono">0.71</td>
                <td class="num mono">0.74</td>
                <td class="num mono">4.80%</td>
                <td class="num mono">34.0%</td>
              </tr>
              <tr>
                <td>原始 PP-OCRv4 + Qwen2.5-VL-7B LoRA SFT <span class="v-tag mono">+ SFT</span></td>
                <td class="num mono">0.79</td>
                <td class="num mono">0.83</td>
                <td class="num mono">2.60%</td>
                <td class="num mono">52.0%</td>
              </tr>
              <tr>
                <td>微调 PP-OCRv4（仅识别）+ QLoRA SFT <span class="v-tag mono">+ OCR 微调</span></td>
                <td class="num mono">0.84</td>
                <td class="num mono">0.87</td>
                <td class="num mono">1.90%</td>
                <td class="num mono">59.5%</td>
              </tr>
              <tr>
                <td>+ 主动 300 DPI 放大 + Leontief 符号校验 <span class="v-tag mono">+ 神经符号</span></td>
                <td class="num mono">0.89</td>
                <td class="num mono">0.94</td>
                <td class="num mono">1.30%</td>
                <td class="num mono">66.0%</td>
              </tr>
              <tr class="hi">
                <td>VeriUBO 完整版（+ 非对称风险 DPO + Conformal 门控）<span class="v-tag mono">16GB 目标</span></td>
                <td class="num mono">0.92</td>
                <td class="num mono">0.97</td>
                <td class="num mono">0.82%</td>
                <td class="num mono">73.5%</td>
              </tr>
              <tr class="ref">
                <td>GPT-4o + 符号校验器 <span class="v-tag mono">云端参考</span></td>
                <td class="num mono">0.88</td>
                <td class="num mono">0.93</td>
                <td class="num mono">1.40%</td>
                <td class="num mono">64.5%</td>
              </tr>
            </tbody>
          </table>
        </div>

      </div>
    </section>

    <section class="block">
      <p class="b-label mono">06 — 实测结果与诚实边界</p>
      <h2>哪些经过实测，原型又止步于何处。</h2>
      <div class="goals three">
        <div class="goal">
          <span class="g-num mono">9 / 9 门禁</span>
          <h3>FATF 企业尽调闭环</h3>
          <p>覆盖登记与 GLEIF LEI、经营档案、股权文件、图谱穿透、签字授权、自然人身份、制裁、高风险尽调与审批。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">19,629 条名单</span>
          <h3>OFAC SDN + GLEIF 实时查册</h3>
          <p>接入真实公开 OFAC SDN 名单本地筛查主名与别名，并支持 GLEIF LEI 实时查询与主体错配拦截。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">35 次工具调用</span>
          <h3>本机 LLM 全链路回放</h3>
          <p>实测本机 Qwen2.5-0.5B-Instruct 走通八个阶段，包含独立四眼审批与登记变更触发的自动重开。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">诚实边界 · 01</span>
          <h3>PEP 与负面舆情</h3>
          <p>制裁筛查已接入真实名单，政治公众人物（PEP）与负面舆情仍保留为带引证来源的人工研究与复核。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">诚实边界 · 02</span>
          <h3>陌生文件自动提取</h3>
          <p>已建图案件的循环求解与合并重算经过实测，任意陌生海外公司股权 PDF 的零样本 OCR 准确率尚未单独评测。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">诚实边界 · 03</span>
          <h3>企业级身份接入</h3>
          <p>本机角色切换用于验证四眼复核逻辑；真实上线需接入企业 SSO/IAM 身份认证与外部工商变更订阅源。</p>
        </div>
      </div>
    </section>

    <p class="tbc"><span class="tbc-dots">…</span>To be continued</p>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .case { padding: 130px 24px 90px; max-width: 880px; }
  .back {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
    transition: color 0.25s;
  }
  .back:hover { color: var(--accent); }
  .head { margin-top: 34px; }
  .head h1 { font-size: clamp(44px, 7vw, 76px); }
  .zh-name {
    margin: 8px 0 0;
    font-size: 13px;
    letter-spacing: 0.26em;
    color: var(--accent);
  }
  .lede {
    margin: 18px 0 0;
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.8;
    color: var(--ink-2);
    max-width: 650px;
  }
  .try-live {
