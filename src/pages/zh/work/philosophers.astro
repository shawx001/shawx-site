---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';

const lang = 'zh' as const;
---

<Base
  lang={lang}
  title="对话哲学家 — Shaw X"
  description="把 26 位蒸馏好的思想家拉进一个群聊 —— 话筒永远给最想说话的那个人。"
>
  <Nav lang={lang} />
  <main class="container case">
    <a class="back mono" href="/zh/#work">← 精选作品</a>

    <header class="head">
      <h1>Talk to Philosophers</h1>
      <p class="zh-name mono">对话哲学家</p>
      <p class="lede">
        把 26 位蒸馏好的思想家拉进一个群聊：抛出问题，他们自动讨论、互相反驳，
        你随时插话 —— 话筒永远给最想说话的那个人。
      </p>
      <a class="try-live" href="https://philosophers.tail0820a5.ts.net/" target="_blank" rel="noopener">
        立即体验 <span class="tl-arrow">↗</span>
      </a>
    </header>

    <div class="meta">
      <div class="meta-item">
        <span class="meta-label mono">Context</span>
        <span class="meta-value">独立产品<br />2026 · v1 已上线</span>
      </div>
      <div class="meta-item">
        <span class="meta-label mono">My role</span>
        <span class="meta-value">创始人 —— 产品、<br />设计、工程</span>
      </div>
      <div class="meta-item">
        <span class="meta-label mono">Status</span>
        <span class="meta-value">网页版可玩<br />微信接入 = v2</span>
      </div>
    </div>

    <!-- 沙龙现场 -->
    <div class="salon" role="img" aria-label="群聊《诸神的黄昏》：用户问"如果一切都是注定的，努力还有意义吗"，全员举手竞价，尼采以 87 分胜出并发言，庄子正在举手">
      <div class="s-bar">
        <span class="s-title">诸神的黄昏</span>
        <span class="s-count mono">4 位思想家 · 深谈</span>
      </div>
      <div class="s-body">
        <div class="msg user">
          <p>如果一切都是注定的，努力还有意义吗？</p>
        </div>
        <div class="bidrow mono" aria-hidden="true">
          <span class="b-label">举手竞价</span>
          <span class="bid win">尼采 87</span>
          <span class="bid">加缪 78</span>
          <span class="bid">康德 71</span>
          <span class="bid">庄子 62</span>
        </div>
        <div class="msg bot">
          <span class="avatar a-n" aria-hidden="true">尼</span>
          <div class="m-block">
            <span class="m-name">尼采</span>
            <p>
              你问反了。意义从来不是"有没有"，而是你敢不敢亲手立一个。
              永恒轮回不是枷锁 —— 是试金石：这一生若要无限重复，
              你现在的活法，配吗？
            </p>
          </div>
        </div>
        <div class="typing mono"><i class="t-dot"></i>庄子 正在举手…</div>
      </div>
    </div>
    <p class="shot-cap mono">沙龙现场 —— 界面为概念设计</p>

    <section class="block">
      <p class="b-label mono">01 — 概览</p>
      <h2>读思想家是独白，这里是研讨会。</h2>
      <p>
        书架上的尼采永远不会反驳你手里的庄子。把 26 位思想家蒸馏成人格、
        拉进同一个群聊之后，最有意思的事情发生了：马克思和薛兆丰同台、
        老庄一桌、李诞乱入康德 —— <strong>组合本身就是玩法</strong>。
        你抛出一个问题，看他们怎么吵；想说话，随时插。
      </p>
    </section>

    <section class="block">
      <p class="b-label mono">02 — 它怎么运转</p>
      <h2>没有主持人，话筒自己找人。</h2>
      <div class="steps">
        <div class="step">
          <span class="s-num">1</span>
          <h3>建群拉人</h3>
          <p>从 26 位思想家里勾 2-8 位，选清谈或深谈。</p>
        </div>
        <div class="step">
          <span class="s-num">2</span>
          <h3>全员竞价</h3>
          <p>每条消息落地，所有人给自己打分："我多想说这句话。"</p>
        </div>
        <div class="step">
          <span class="s-num">3</span>
          <h3>胜者发言</h3>
          <p>最高分拿到话筒，流式输出。没人想说，就安静等你。</p>
        </div>
      </div>
    </section>

    <section class="block">
      <p class="b-label mono">03 — 功能</p>
      <h2>四个让它活起来的机制。</h2>

      <div class="feature">
        <div class="f-text">
          <h3>举手竞价编排</h3>
          <p>
            一次廉价的并行调用，全员报出分数和意图。确定性降权防对喷：
            刚发言 ×0.5，刷屏 ×0.3，被点名 +30。全员低于 35 分 ——
            讨论自然冷场，等你开口。
          </p>
        </div>
        <div class="f-visual">
          <div class="auction">
            <p class="fc-head mono">第 7 轮 · 竞价</p>
            <div class="a-row win"><span class="a-name">尼采</span><span class="a-bar"><i style="width:87%"></i></span><span class="a-val mono">87</span></div>
            <div class="a-row"><span class="a-name">加缪</span><span class="a-bar"><i style="width:78%"></i></span><span class="a-val mono">78</span></div>
            <div class="a-row"><span class="a-name">康德</span><span class="a-bar"><i style="width:71%"></i></span><span class="a-val mono">71<em class="a-tag">被点名 +30</em></span></div>
            <div class="a-row dim"><span class="a-name">王小波</span><span class="a-bar"><i style="width:28%"></i></span><span class="a-val mono">28<em class="a-tag">刚发言 ×0.5</em></span></div>
            <p class="r-cap mono">最高分发言 · 全员 &lt;35 = 冷场</p>
          </div>
        </div>
      </div>

      <div class="feature flip">
        <div class="f-text">
          <h3>六层人格蒸馏</h3>
          <p>
            每位思想家是一个纯数据文件：表达 DNA、心智模型、决策启发式、
            反模式与价值观、诚实边界，再加一层著作思想库 ——
            发言者"拥有"自己的书，而不是检索资料。
          </p>
        </div>
        <div class="f-visual">
          <div class="distill">
            <p class="fc-head mono">nietzsche.md</p>
            <span class="d-layer">表达 DNA</span>
            <span class="d-layer">心智模型</span>
            <span class="d-layer">决策启发式</span>
            <span class="d-layer">反模式与价值观</span>
            <span class="d-layer">诚实边界</span>
            <span class="d-layer accent">著作思想库 ·《查拉图斯特拉》《道德的谱系》…</span>
            <p class="r-cap mono">加一位思想家 = 丢一个 markdown 文件</p>
          </div>
        </div>
      </div>

      <div class="feature">
        <div class="f-text">
          <h3>清谈与深谈</h3>
          <p>
            清谈快 —— 每条发言前有一次隐藏的思考调用，再压缩成群聊消息；
            深谈慢 —— 推理模型正面接住上一位的最强论证，一条要等半分钟，
            但深度完全不同。
          </p>
        </div>
        <div class="f-visual">
          <div class="modes">
            <div class="mode-card">
              <span class="mc-name">清谈</span>
              <span class="mc-sub mono">deepseek-chat</span>
              <p>秒回 · 隐藏思考 · 适合斗嘴</p>
            </div>
            <div class="mode-card on">
              <span class="mc-name">深谈</span>
              <span class="mc-sub mono">deepseek-reasoner</span>
              <p>30-90 秒一条 · 接住最强论证</p>
            </div>
          </div>
        </div>
      </div>

      <div class="feature flip">
        <div class="f-text">
          <h3>你随时插话</h3>
          <p>
            讨论立即围绕你的新输入转向；"停止讨论"一键叫停；
            连续 12 条强制停顿 —— 成本护栏让一场 20 条的讨论只要几分钱。
          </p>
        </div>
        <div class="f-visual">
          <div class="interject">
            <div class="msg user small"><p>等等，你们都没回答"我"该怎么办</p></div>
            <p class="pivot mono">↓ 讨论转向你的问题</p>
            <div class="msg bot small">
              <span class="avatar a-z" aria-hidden="true">庄</span>
              <div class="m-block">
                <span class="m-name">庄子</span>
                <p>你看，连"该怎么办"也是个笼子。…</p>
              </div>
            </div>
            <p class="r-cap mono">20 条讨论 ≈ 几分钱 · 12 条强制停顿</p>
          </div>
        </div>
      </div>
    </section>

    <section class="block">
      <p class="b-label mono">04 — 组合即玩法</p>
      <h2>拉谁进群，就是你的策展。</h2>
      <div class="goals three">
        <div class="goal">
          <span class="g-num mono">擂台</span>
          <h3>马克思 × 薛兆丰</h3>
          <p>政治经济学的世纪对账。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">双打</span>
          <h3>老子 × 庄子</h3>
          <p>道家同桌，看谁更"无为"。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">乱入</span>
          <h3>李诞 × 康德</h3>
          <p>脱口秀闯进三大批判。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">深渊</span>
          <h3>尼采 × 陀思妥耶夫斯基</h3>
          <p>谁先眨眼，谁先信神。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">在场</span>
          <h3>项飙 × 布迪厄</h3>
          <p>"附近"遇上"场域"。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">迷宫</span>
          <h3>博尔赫斯 × 马尔克斯</h3>
          <p>拉美双星，虚构对虚构。</p>
        </div>
      </div>
      <div class="roster">
        <span class="r-chip mono">26 位在册</span>
        <span class="r-names">尼采 · 荣格 · 加缪 · 黑格尔 · 叔本华 · 福柯 · 麦克卢汉 · 王小波 · 余华 · 昆德拉 · 拉康 · 歌德 · 刘擎 · 戴锦华 …</span>
      </div>
    </section>

    <p class="tbc"><span class="tbc-dots">…</span>To be continued</p>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .case { padding: 130px 24px 90px; max-width: 880px; }
  .back {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
    transition: color 0.25s;
  }
  .back:hover { color: var(--accent); }
  .head { margin-top: 34px; }
  .head h1 { font-size: clamp(44px, 7vw, 76px); }
  .zh-name {
    margin: 8px 0 0;
    font-size: 13px;
    letter-spacing: 0.3em;
    color: var(--accent);
  }
  .lede {
    margin: 18px 0 0;
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.8;
    color: var(--ink-2);
    max-width: 640px;
  }
  .try-live {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 28px;
    padding: 12px 26px;
    border-radius: 999px;
    background: var(--accent);
    color: #FFFDF8;
    font-size: 14.5px;
    font-weight: 500;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s;
    box-shadow: 0 14px 30px -14px rgba(216, 90, 48, 0.6);
  }
  .try-live:hover { transform: translateY(-2px); box-shadow: 0 20px 38px -16px rgba(216, 90, 48, 0.7); }
  .tl-arrow { transition: transform 0.25s; }
  .try-live:hover .tl-arrow { transform: translate(2px, -2px); }
  .meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 52px;
    padding: 28px 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .meta-item { display: flex; flex-direction: column; gap: 8px; }
  .meta-label {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .meta-value { font-size: 14px; line-height: 1.7; color: var(--ink); }

  /* —— 沙龙群聊 mockup —— */
  .salon {
    margin-top: 56px;
    border-radius: 18px;
    overflow: hidden;
    background: #1A112E;
    box-shadow: 0 36px 80px -42px rgba(44, 36, 24, 0.55);
  }
  .s-bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 20px 28px;
    border-bottom: 1px solid rgba(245, 239, 228, 0.12);
  }
  .s-title {
    font-family: var(--serif);
    font-size: clamp(17px, 2.2vw, 21px);
    color: #F5EFE4;
  }
  .s-count { font-size: 11px; letter-spacing: 0.14em; color: rgba(240, 234, 248, 0.55); }
  .s-body {
    padding: 26px 28px 30px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 640px;
    margin: 0 auto;
  }
  .msg { display: flex; gap: 12px; }
  .msg p { margin: 0; font-size: 14.5px; line-height: 1.75; }
  .msg.user { justify-content: flex-end; }
  .msg.user p {
    background: #F0937A;
    color: #1A112E;
    border-radius: 16px 16px 4px 16px;
    padding: 12px 18px;
    max-width: 75%;
  }
  .msg.bot .m-block {
    background: rgba(245, 239, 228, 0.07);
    border: 1px solid rgba(245, 239, 228, 0.14);
    border-radius: 4px 16px 16px 16px;
    padding: 12px 18px;
    color: rgba(245, 239, 228, 0.92);
    max-width: 82%;
  }
  .m-name {
    display: block;
    font-family: var(--serif);
    font-size: 13px;
    color: #F0937A;
    margin-bottom: 5px;
  }
  .avatar {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--serif);
    font-size: 15px;
    color: #1A112E;
  }
  .a-n { background: linear-gradient(150deg, #F0937A, #C8502F); }
  .a-z { background: linear-gradient(150deg, #8EC9A8, #4B8E6F); }
  .bidrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .b-label { color: rgba(240, 234, 248, 0.45); margin-right: 4px; }
  .bid {
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid rgba(245, 239, 228, 0.22);
    color: rgba(245, 239, 228, 0.75);
  }
  .bid.win {
    border-color: #F0937A;
    color: #F0937A;
    box-shadow: 0 0 14px rgba(240, 147, 122, 0.25);
  }
  .typing {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    letter-spacing: 0.08em;
    color: rgba(240, 234, 248, 0.5);
  }
  .t-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #F0937A;
    animation: tblink 1.4s ease-in-out infinite;
  }
  @keyframes tblink { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
  .shot-cap {
    margin: 14px 0 0;
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-2);
  }

  .block { margin-top: 88px; }
  .b-label {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .block h2 { margin-top: 12px; font-size: clamp(26px, 3.6vw, 38px); }
  .block > p {
    margin: 18px 0 0;
    font-size: 15.5px;
    line-height: 1.9;
    color: var(--ink);
    max-width: 660px;
  }
  .block > p strong { color: var(--accent); font-weight: 600; }

  /* —— 编辑式三步 —— */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 4vw, 44px);
    margin-top: 36px;
    border-top: 1px solid var(--hairline);
    padding-top: 32px;
  }
  .s-num {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(38px, 5vw, 56px);
    line-height: 1;
    color: var(--accent);
  }
  .step h3 { font-size: 18px; margin-top: 14px; }
  .step p { margin: 8px 0 0; font-size: 13.5px; line-height: 1.8; color: var(--ink-2); }

  /* —— features —— */
  .feature {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    margin-top: 64px;
  }
  .feature.flip .f-text { order: 2; }
  .feature.flip .f-visual { order: 1; }
  .f-text h3 { font-size: clamp(20px, 2.6vw, 26px); }
  .f-text p { margin: 10px 0 0; font-size: 14.5px; line-height: 1.85; color: var(--ink-2); }
  .f-visual { min-width: 0; }
  .fc-head {
    margin: 0 0 14px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .r-cap { margin: 14px 0 0; font-size: 10.5px; letter-spacing: 0.1em; color: var(--ink-2); }

  /* 竞价可视化 */
  .auction {
    background: var(--paper, #FFFDF8);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    padding: 24px 26px;
    box-shadow: 0 28px 60px -36px rgba(44, 36, 24, 0.5);
  }
  .a-row {
    display: grid;
    grid-template-columns: 4.5em 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
  }
  .a-name { font-family: var(--serif); font-size: 14.5px; color: var(--ink); }
  .a-bar {
    height: 8px;
    border-radius: 4px;
    background: rgba(44, 36, 24, 0.08);
    overflow: hidden;
  }
  .a-bar i { display: block; height: 100%; border-radius: 4px; background: var(--ink-2); opacity: 0.45; }
  .a-row.win .a-bar i { background: var(--accent); opacity: 1; }
  .a-row.win .a-name { color: var(--accent); }
  .a-val { font-size: 12.5px; color: var(--ink); display: inline-flex; align-items: center; gap: 8px; }
  .a-tag {
    font-style: normal;
    font-size: 9.5px;
    letter-spacing: 0.06em;
    color: var(--ink-2);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 1px 8px;
  }
  .a-row.dim { opacity: 0.55; }

  /* 蒸馏分层 */
  .distill {
    background: var(--paper, #FFFDF8);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    padding: 24px 26px;
    box-shadow: 0 28px 60px -36px rgba(44, 36, 24, 0.5);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .d-layer {
    border: 1px solid var(--hairline);
    border-radius: 8px;
    padding: 9px 14px;
    font-size: 13px;
    color: var(--ink);
  }
  .d-layer.accent {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(216, 90, 48, 0.05);
  }

  /* 模式对比 */
  .modes { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .mode-card {
    background: var(--paper, #FFFDF8);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    padding: 22px;
    box-shadow: 0 28px 60px -36px rgba(44, 36, 24, 0.5);
  }
  .mode-card.on { border-color: var(--accent); }
  .mc-name { font-family: var(--serif); font-size: 20px; color: var(--ink); display: block; }
  .mode-card.on .mc-name { color: var(--accent); }
  .mc-sub { display: block; font-size: 10.5px; letter-spacing: 0.1em; color: var(--ink-2); margin-top: 4px; }
  .mode-card p { margin: 12px 0 0; font-size: 12.5px; line-height: 1.7; color: var(--ink-2); }

  /* 插话 */
  .interject {
    background: #1A112E;
    border-radius: 14px;
