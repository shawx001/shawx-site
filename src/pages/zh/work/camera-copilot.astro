---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';

const lang = 'zh' as const;
---

<Base
  lang={lang}
  title="AI Camera Copilot — Shaw X"
  description="懂你审美的拍照副驾 —— 站哪、怎么构图、参数怎么调，它都告诉你。"
>
  <Nav lang={lang} />
  <main class="container case">
    <a class="back mono" href="/zh/#work">← 精选作品</a>

    <header class="head">
      <h1>AI Camera Copilot</h1>
      <p class="lede">
        一个懂你审美的拍照副驾 —— 带你走到那张照片面前：
        站在哪、怎么构图、参数怎么调。
      </p>
    </header>

    <div class="meta">
      <div class="meta-item">
        <span class="meta-label mono">Context</span>
        <span class="meta-value">独立产品<br />2026 · 设计中</span>
      </div>
      <div class="meta-item">
        <span class="meta-label mono">My role</span>
        <span class="meta-value">创始人 —— 产品、<br />设计、架构</span>
      </div>
      <div class="meta-item">
        <span class="meta-label mono">Status</span>
        <span class="meta-value">体验已设计，<br />原型即将动工</span>
      </div>
    </div>

    <figure class="shot">
      <img src="/case/camera/p-hero.jpg" alt="水岸边拍人像，副驾实时建议：向左一小步、相机抬高一点 —— 主体位置好，引导线有力，构图 85 分" width="1400" height="788" />
      <figcaption class="mono">实时指导 —— 向左一步、抬高一点，曝光已调好</figcaption>
    </figure>

    <section class="block">
      <p class="b-label mono">01 — 概览</p>
      <h2>人人都有审美，但不是人人都有技术。</h2>
      <p>
        你很清楚自己喜欢什么样的照片 —— 只是不一定每次都拍得出来。
        "看见的照片"和"拍到的照片"之间隔着技术：站位、构图、光线、参数。
        Camera Copilot 从你心里那张照片出发，学会你的审美，
        然后一帧一帧地把这段距离补上。
      </p>
    </section>

    <section class="block">
      <p class="b-label mono">02 — 它怎么工作</p>
      <h2>给它看你的喜欢，剩下交给它。</h2>
      <div class="steps">
        <div class="step">
          <span class="s-num">1</span>
          <h3>给它看你的喜欢</h3>
          <p>你喜欢的照片 —— 你拍的或别人拍的 —— 就是需求文档。</p>
        </div>
        <div class="step">
          <span class="s-num">2</span>
          <h3>它读懂场景</h3>
          <p>光线、主体、几何 —— 在你举起相机的瞬间实时理解。</p>
        </div>
        <div class="step">
          <span class="s-num">3</span>
          <h3>它带你走过去</h3>
          <p>站位、构图、参数 —— 在你按下快门之前全部就位。</p>
        </div>
      </div>
    </section>

    <section class="block">
      <p class="b-label mono">03 — 功能</p>
      <h2>它为你的眼睛做的六件事。</h2>

      <div class="feature">
        <div class="f-text">
          <h3>学会你的眼睛</h3>
          <p>
            上传你喜欢的照片。它把它们提炼成一份审美档案，
            再把眼前的画面和"你想拍出的那张"实时比对 —— 并告诉你差距怎么补上。
          </p>
        </div>
        <figure class="f-visual">
          <img src="/case/camera/p-match.jpg" alt="手机上目标照片与实时取景并排，匹配度 94%，并给出平移、俯仰、变焦建议" width="1400" height="788" loading="lazy" />
        </figure>
      </div>

      <div class="feature flip">
        <div class="f-text">
          <h3>带你走到那张照片</h3>
          <p>
            不只是"这里好看"—— 构图指引直接画在取景框里，下一步说得明明白白：
            往左一步、蹲低一点、等光到位。
          </p>
        </div>
        <figure class="f-visual">
          <img src="/case/camera/p-guide.jpg" alt="黄金时刻的相机背屏：水平、主体、构图检查通过，建议向左微调让画面更平衡" width="1400" height="788" loading="lazy" />
        </figure>
      </div>

      <div class="feature">
        <div class="f-text">
          <h3>参数替你拧好</h3>
          <p>
            ISO、光圈、快门、白平衡 —— 为你即将按下的这一张调好。
            一键应用，或者你自己拧。
          </p>
        </div>
        <figure class="f-visual">
          <img src="/case/camera/p-night.jpg" alt="夜晚街头，副驾调好手动参数：1/160、f/1.8、ISO 800 —— 人脸已识别，构图 82 分" width="1400" height="788" loading="lazy" />
        </figure>
      </div>

      <div class="feature flip">
        <div class="f-text">
          <h3>按你的审美调色</h3>
          <p>
            后期以"你的配方"出现 —— 裁切、光线、色彩、主体 ——
            一眼就能比对的 before / after。
          </p>
        </div>
        <figure class="f-visual">
          <img src="/case/camera/grade.svg" alt="平板上的前后对比调色：色温 +12、对比 +8、阴影提亮、颗粒 6" width="1600" height="900" loading="lazy" />
        </figure>
      </div>

      <div class="feature">
        <div class="f-text">
          <h3>专业相机也欢迎</h3>
          <p>
            连接真正的机身，读 RAW、懂手动。照片同步到回看台，
            副驾按你的审美标出值得留下的那几张。
          </p>
        </div>
        <figure class="f-visual">
          <img src="/case/camera/p-desk.jpg" alt="笔记本上的副驾回看台，旁边是专业机身和无人机遥控器 —— 任务、航线、修图建议都在一处" width="1400" height="788" loading="lazy" />
        </figure>
      </div>

      <div class="feature flip">
        <div class="f-text">
          <h3>无人机自动找角度</h3>
          <p>
            飞来飞去找角度是航拍最无聊的部分。副驾自动巡航选角度、定高度、构好图 ——
            你只负责点头。
          </p>
        </div>
        <figure class="f-visual">
          <img src="/case/camera/p-mission.jpg" alt="无人机任务控制台：3D 地形图上环绕航点已规划，85mm、120 米 —— 一键发送任务" width="1400" height="788" loading="lazy" />
        </figure>
      </div>
    </section>

    <figure class="band">
      <img src="/case/camera/p-coast.jpg" alt="手持无人机遥控器俯瞰金色海岸公路，副驾以 91% 匹配度锁定镜头，无人机稳住角度" width="1400" height="788" loading="lazy" />
      <figcaption class="mono">副驾勘好角度 —— 你来飞故事</figcaption>
    </figure>

    <section class="block">
      <p class="b-label mono">04 — 覆盖范围</p>
      <h2>一双眼睛，什么都能拍。</h2>
      <div class="goals three">
        <div class="goal">
          <span class="g-num mono">24mm</span>
          <h3>街拍</h3>
          <p>参数提前拧好，瞬间不等菜单。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">85mm</span>
          <h3>人像</h3>
          <p>脸上的光、引导的距离、镜头的压缩感 —— 都替你想好。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">16mm</span>
          <h3>风光</h3>
          <p>地平线、前景锚点、黄金时刻的时机。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">30s</span>
          <h3>夜景</h3>
          <p>长曝光的数学题，不用一遍遍试错。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">42m</span>
          <h3>航拍</h3>
          <p>起飞之前，角度已经勘好。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">RAW</span>
          <h3>任何相机</h3>
          <p>手机、微单、无人机 —— 共用同一份审美档案。</p>
        </div>
      </div>
    </section>

    <figure class="band">
      <img src="/case/camera/p-water.jpg" alt="黄昏水岸，副驾把参考照片与眼前场景匹配并规划航线，无人机悬停在人物上方" width="1400" height="788" loading="lazy" />
      <figcaption class="mono">参考已匹配，航线已规划 —— 入夜后还是同一双眼睛</figcaption>
    </figure>

    <p class="tbc"><span class="tbc-dots">…</span>To be continued</p>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .case { padding: 130px 24px 90px; max-width: 880px; }
  .back {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
    transition: color 0.25s;
  }
  .back:hover { color: var(--accent); }
  .head { margin-top: 34px; }
  .head h1 { font-size: clamp(40px, 6.4vw, 72px); }
  .lede {
    margin: 18px 0 0;
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.8;
    color: var(--ink-2);
    max-width: 640px;
  }
  .meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 52px;
    padding: 28px 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .meta-item { display: flex; flex-direction: column; gap: 8px; }
  .meta-label {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .meta-value { font-size: 14px; line-height: 1.7; color: var(--ink); }

  .shot { margin: 56px 0 0; }
  .shot img, .band img {
    width: 100%;
    height: auto;
    border-radius: 18px;
    display: block;
    box-shadow: 0 36px 80px -42px rgba(44, 36, 24, 0.55);
  }
  .band { margin: 88px 0 0; }
  .shot figcaption, .band figcaption {
    margin-top: 14px;
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-2);
  }

  .block { margin-top: 88px; }
  .b-label {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .block h2 { margin-top: 12px; font-size: clamp(26px, 3.6vw, 38px); }
  .block > p {
    margin: 18px 0 0;
    font-size: 15.5px;
    line-height: 1.9;
    color: var(--ink);
    max-width: 660px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 4vw, 44px);
    margin-top: 36px;
    border-top: 1px solid var(--hairline);
    padding-top: 32px;
  }
  .s-num {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(38px, 5vw, 56px);
    line-height: 1;
    color: var(--accent);
  }
  .step h3 { font-size: 18px; margin-top: 14px; }
  .step p { margin: 8px 0 0; font-size: 13.5px; line-height: 1.8; color: var(--ink-2); }

  .feature {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    margin-top: 64px;
  }
  .feature.flip .f-text { order: 2; }
  .feature.flip .f-visual { order: 1; }
  .f-text h3 { font-size: clamp(20px, 2.6vw, 26px); }
  .f-text p { margin: 10px 0 0; font-size: 14.5px; line-height: 1.85; color: var(--ink-2); }
  .f-visual { margin: 0; }
  .f-visual img {
    width: 100%;
    height: auto;
    border-radius: 14px;
    display: block;
    box-shadow: 0 28px 60px -36px rgba(44, 36, 24, 0.5);
  }

  .goals {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 28px;
  }
  .goals.three { grid-template-columns: repeat(3, 1fr); }
  .goal { border: 1px solid var(--hairline); border-radius: 14px; padding: 22px 22px 20px; }
  .g-num {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .goal h3 { font-size: 18px; margin-top: 10px; }
  .goal p { margin: 8px 0 0; font-size: 13px; line-height: 1.75; color: var(--ink-2); }

  .tbc {
    margin: 130px 0 30px;
    text-align: center;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(30px, 4.5vw, 48px);
    letter-spacing: 0.01em;
    color: var(--ink);
  }
  .tbc-dots { color: var(--accent); margin-right: 0.18em; }

  @media (max-width: 720px) {
    .meta { grid-template-columns: 1fr; gap: 20px; }
    .goals, .goals.three { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr; gap: 28px; }
    .block { margin-top: 64px; }
    .band { margin-top: 64px; }
    .feature { grid-template-columns: 1fr; gap: 18px; margin-top: 48px; }
    .feature.flip .f-text { order: 1; }
    .feature.flip .f-visual { order: 2; }
  }
</style>
