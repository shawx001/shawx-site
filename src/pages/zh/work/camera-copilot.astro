---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';

const lang = 'zh' as const;
---

<Base
  lang={lang}
  title="AI Camera Copilot — Shaw X"
  description="懂你审美的拍照副驾 —— 站哪、怎么构图、参数怎么调，它都告诉你。"
>
  <Nav lang={lang} />
  <main class="container case">
    <a class="back mono" href="/zh/#work">← 精选作品</a>

    <header class="head">
      <h1>AI Camera Copilot</h1>
      <p class="lede">
        一个懂你审美的拍照副驾 —— 带你走到那张照片面前：
        站在哪、怎么构图、参数怎么调。
      </p>
    </header>

    <div class="meta">
      <div class="meta-item">
        <span class="meta-label mono">Context</span>
        <span class="meta-value">独立产品<br />2026 · 设计中</span>
      </div>
      <div class="meta-item">
        <span class="meta-label mono">My role</span>
        <span class="meta-value">创始人 —— 产品、<br />设计、架构</span>
      </div>
      <div class="meta-item">
        <span class="meta-label mono">Status</span>
        <span class="meta-value">体验已设计，<br />原型即将动工</span>
      </div>
    </div>

    <div class="vf" role="img" aria-label="相机取景器，副驾提示：黄金时刻还有 12 分钟，向西走 40 米，逆光拍摄">
      <div class="vf-grid" aria-hidden="true"></div>
      <span class="vf-corner tl" aria-hidden="true"></span>
      <span class="vf-corner tr" aria-hidden="true"></span>
      <span class="vf-corner bl" aria-hidden="true"></span>
      <span class="vf-corner br" aria-hidden="true"></span>
      <span class="vf-focus" aria-hidden="true"></span>
      <p class="vf-toast mono">黄金时刻还有 12 分钟 —— 向西走 40 米，逆光拍</p>
      <div class="vf-bar mono">
        <span>ISO 100</span>
        <span>f/2.8</span>
        <span>1/250</span>
        <span>EV +0.3</span>
        <span class="vf-rec">● AI</span>
      </div>
    </div>
    <p class="vf-cap mono">副驾的工作瞬间 · 概念画面</p>

    <section class="block">
      <p class="b-label mono">01 — 概览</p>
      <h2>人人都有审美，但不是人人都有技术。</h2>
      <p>
        你很清楚自己喜欢什么样的照片 —— 只是不一定每次都拍得出来。
        "看见的照片"和"拍到的照片"之间隔着技术：站位、构图、光线、参数。
        Camera Copilot 从你心里那张照片出发，学会你的审美，
        然后一帧一帧地把这段距离补上。
      </p>
    </section>

    <section class="block">
      <p class="b-label mono">02 — 它怎么工作</p>
      <h2>给它看你的喜欢，剩下交给它。</h2>
      <div class="pipeline" role="img" aria-label="产品流程：给它看你喜欢的照片，它实时读懂眼前的场景，然后带你走到那张照片面前">
        <div class="p-flow">
          <div class="p-step">
            <span class="p-name mono">给它看你的喜欢</span>
            <span class="p-desc">你喜欢的照片，就是需求文档</span>
          </div>
          <span class="p-arrow" aria-hidden="true">→</span>
          <div class="p-step p-core">
            <span class="p-name mono">它读懂场景</span>
            <span class="p-desc">光线、主体、几何 —— 实时</span>
          </div>
          <span class="p-arrow" aria-hidden="true">→</span>
          <div class="p-step">
            <span class="p-name mono">它带你走过去</span>
            <span class="p-desc">站位、构图、参数 —— 全部就位</span>
          </div>
        </div>
        <p class="p-gate mono">手机、微单、无人机 —— 同一双眼睛</p>
      </div>
    </section>

    <section class="block">
      <p class="b-label mono">03 — 功能</p>
      <h2>它为你的眼睛做的六件事。</h2>

      <div class="feature">
        <div class="f-text">
          <h3>学会你的眼睛</h3>
          <p>
            上传你喜欢的照片 —— 你拍的或别人拍的都行。它把它们提炼成一份审美档案：
            你追的光、你留的色、你选的框。
          </p>
        </div>
        <div class="f-visual">
          <div class="taste">
            <div class="t-grid" aria-hidden="true">
              <span class="t-tile t1"></span>
              <span class="t-tile t2"></span>
              <span class="t-tile t3"></span>
              <span class="t-tile t4"></span>
              <span class="t-tile t5"></span>
              <span class="t-tile t6"></span>
            </div>
            <div class="t-tags">
              <span class="q-chip">暖调阴影</span>
              <span class="q-chip">逆光</span>
              <span class="q-chip">留白</span>
            </div>
            <p class="r-cap mono">你的审美档案 · 从 24 张你喜欢的照片学来</p>
          </div>
        </div>
      </div>

      <div class="feature flip">
        <div class="f-text">
          <h3>带你走到那张照片</h3>
          <p>
            不只是"这里好看"—— 它告诉你站哪、朝哪、蹲多低，以及光什么时候最好。
          </p>
        </div>
        <div class="f-visual">
          <div class="mapcard">
            <div class="map" aria-hidden="true">
              <span class="m-you"></span>
              <span class="m-path"></span>
              <span class="m-spot"></span>
              <span class="m-label l-you mono">你在这</span>
              <span class="m-label l-spot mono">那张照片 · 40 m</span>
            </div>
            <p class="map-meta mono">朝西北 · 低机位 · 24 mm</p>
          </div>
        </div>
      </div>

      <div class="feature">
        <div class="f-text">
          <h3>参数替你拧好</h3>
          <p>
            ISO、光圈、快门、白平衡 —— 为你即将按下的这一张调好。
            一键应用，或者你自己拧。
          </p>
        </div>
        <div class="f-visual">
          <div class="dial">
            <p class="fc-head mono">已设定 · 逆光人像</p>
            <div class="dial-grid">
              <div class="d-item"><span class="d-k mono">ISO</span><span class="d-v">100</span></div>
              <div class="d-item"><span class="d-k mono">光圈</span><span class="d-v">f/1.8</span></div>
              <div class="d-item"><span class="d-k mono">快门</span><span class="d-v">1/250</span></div>
              <div class="d-item"><span class="d-k mono">白平衡</span><span class="d-v">5600K</span></div>
            </div>
            <p class="r-cap mono">一键应用 · 也尊重你手动</p>
          </div>
        </div>
      </div>

      <div class="feature flip">
        <div class="f-text">
          <h3>按你的审美调色</h3>
          <p>
            后期以"你的配方"出现 —— 色温、对比、颗粒 ——
            而不是一个套在所有照片上的滤镜。
          </p>
        </div>
        <div class="f-visual">
          <div class="grade">
            <div class="g-strip" aria-hidden="true"></div>
            <div class="g-rows">
              <div class="g-row"><span>色温</span><span class="mono">+12</span></div>
              <div class="g-row"><span>对比</span><span class="mono">+8</span></div>
              <div class="g-row"><span>阴影</span><span class="mono">提亮</span></div>
              <div class="g-row"><span>颗粒</span><span class="mono">6</span></div>
            </div>
            <p class="r-cap mono">你的专属配方 —— 不是预设</p>
          </div>
        </div>
      </div>

      <div class="feature">
        <div class="f-text">
          <h3>专业相机也欢迎</h3>
          <p>
            连接真正的相机机身，读 RAW、懂手动 —— 它的指导尊重你手里的拨轮。
          </p>
        </div>
        <div class="f-visual">
          <div class="rig">
            <div class="rig-row">
              <span class="rig-dot" aria-hidden="true"></span>
              <span class="rig-name">Sony α7 IV</span>
              <span class="rig-tag mono">已连接</span>
            </div>
            <div class="rig-chips">
              <span class="q-chip">Canon</span>
              <span class="q-chip">Nikon</span>
              <span class="q-chip">Fujifilm</span>
              <span class="q-chip">DJI</span>
              <span class="q-chip">iPhone</span>
            </div>
            <p class="r-cap mono">读 RAW · 懂手动</p>
          </div>
        </div>
      </div>

      <div class="feature flip">
        <div class="f-text">
          <h3>无人机自动找角度</h3>
          <p>
            飞来飞去找角度是航拍最无聊的部分。副驾自动巡航选角度、定高度、构好图 ——
            你只负责点头。
          </p>
        </div>
        <div class="f-visual">
          <div class="drone">
            <div class="orbit" aria-hidden="true">
              <span class="o-ring"></span>
              <span class="o-subject"></span>
              <span class="o-dot d1"></span>
              <span class="o-dot d2"></span>
              <span class="o-dot d3"></span>
            </div>
            <p class="drone-meta mono"><span>高度 42 m</span><span>环绕 270°</span><span>已找到 3 个角度</span></p>
          </div>
        </div>
      </div>
    </section>

    <section class="block">
      <p class="b-label mono">04 — 覆盖范围</p>
      <h2>一双眼睛，什么都能拍。</h2>
      <div class="goals three">
        <div class="goal">
          <span class="g-num mono">24mm</span>
          <h3>街拍</h3>
          <p>参数提前拧好，瞬间不等菜单。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">85mm</span>
          <h3>人像</h3>
          <p>脸上的光、引导的距离、镜头的压缩感 —— 都替你想好。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">16mm</span>
          <h3>风光</h3>
          <p>地平线、前景锚点、黄金时刻的时机。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">30s</span>
          <h3>夜景</h3>
          <p>长曝光的数学题，不用一遍遍试错。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">42m</span>
          <h3>航拍</h3>
          <p>起飞之前，角度已经勘好。</p>
        </div>
        <div class="goal">
          <span class="g-num mono">RAW</span>
          <h3>任何相机</h3>
          <p>手机、微单、无人机 —— 共用同一份审美档案。</p>
        </div>
      </div>
    </section>

    <p class="tbc"><span class="tbc-dots">…</span>To be continued</p>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .case { padding: 130px 24px 90px; max-width: 880px; }
  .back {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
    transition: color 0.25s;
  }
  .back:hover { color: var(--accent); }
  .head { margin-top: 34px; }
  .head h1 { font-size: clamp(40px, 6.4vw, 72px); }
  .lede {
    margin: 18px 0 0;
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.8;
    color: var(--ink-2);
    max-width: 640px;
  }
  .meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 52px;
    padding: 28px 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .meta-item { display: flex; flex-direction: column; gap: 8px; }
  .meta-label {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .meta-value { font-size: 14px; line-height: 1.7; color: var(--ink); }

  /* viewfinder hero */
  .vf {
    position: relative;
    margin-top: 56px;
    aspect-ratio: 16 / 9.5;
    border-radius: 18px;
    overflow: hidden;
    background:
      radial-gradient(130% 90% at 50% 105%, rgba(230, 86, 46, 0.4), transparent 58%),
      radial-gradient(60% 40% at 72% 70%, rgba(240, 147, 122, 0.18), transparent 70%),
      linear-gradient(168deg, #2B1B45 0%, #1A112E 58%, #140D24 100%);
  }
  .vf-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(245, 239, 228, 0.13) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(245, 239, 228, 0.13) 1px, transparent 1px);
    background-size: 33.4% 33.4%;
    background-position: -1px -1px;
  }
  .vf-corner {
    position: absolute;
    width: 26px;
    height: 26px;
    border: 2px solid rgba(245, 239, 228, 0.7);
  }
  .vf-corner.tl { top: 16px; left: 16px; border-right: none; border-bottom: none; }
  .vf-corner.tr { top: 16px; right: 16px; border-left: none; border-bottom: none; }
  .vf-corner.bl { bottom: 16px; left: 16px; border-right: none; border-top: none; }
  .vf-corner.br { bottom: 16px; right: 16px; border-left: none; border-top: none; }
  .vf-focus {
    position: absolute;
    left: 62%;
    top: 52%;
    width: clamp(64px, 12vw, 96px);
    height: clamp(48px, 9vw, 72px);
    transform: translate(-50%, -50%);
    border: 1.5px solid #F0937A;
    border-radius: 6px;
    box-shadow: 0 0 24px rgba(240, 147, 122, 0.35);
  }
  .vf-toast {
    position: absolute;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    max-width: 82%;
    text-align: center;
    font-size: clamp(10px, 1.4vw, 12px);
    letter-spacing: 0.06em;
    color: #F5EFE4;
    background: rgba(16, 10, 30, 0.72);
    border: 1px solid rgba(240, 147, 122, 0.55);
    border-radius: 999px;
    padding: 8px 18px;
    backdrop-filter: blur(6px);
  }
  .vf-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: clamp(14px, 4.5vw, 40px);
    padding: 16px 12px 14px;
    background: linear-gradient(transparent, rgba(8, 5, 18, 0.7));
    font-size: clamp(10px, 1.4vw, 12px);
    letter-spacing: 0.1em;
    color: #F5EFE4;
  }
  .vf-rec { color: #F0937A; }
  .vf-cap {
    margin: 14px 0 0;
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-2);
  }

  .block { margin-top: 88px; }
  .b-label {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .block h2 { margin-top: 12px; font-size: clamp(26px, 3.6vw, 38px); }
  .block > p {
    margin: 18px 0 0;
    font-size: 15.5px;
    line-height: 1.9;
    color: var(--ink);
    max-width: 660px;
  }

  /* pipeline */
  .pipeline {
    margin-top: 28px;
    background: #1A112E;
    border-radius: 18px;
    padding: clamp(24px, 4vw, 44px);
  }
  .p-flow { display: flex; align-items: stretch; gap: 12px; flex-wrap: wrap; }
  .p-step {
    flex: 1 1 160px;
    border: 1px solid rgba(245, 239, 228, 0.22);
    border-radius: 12px;
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .p-core { border-color: #F0937A; background: rgba(240, 147, 122, 0.08); }
  .p-name { font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: #F5EFE4; }
  .p-core .p-name { color: #F0937A; }
  .p-desc { font-size: 12.5px; line-height: 1.6; color: rgba(240, 234, 248, 0.66); }
  .p-arrow { align-self: center; color: #F0937A; font-size: 16px; }
  .p-gate {
    margin: 22px 0 0;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-align: center;
    color: rgba(240, 234, 248, 0.55);
  }

  /* features */
  .feature {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    margin-top: 56px;
  }
  .feature.flip .f-text { order: 2; }
  .feature.flip .f-visual { order: 1; }
  .f-text h3 { font-size: clamp(20px, 2.6vw, 26px); }
  .f-text p { margin: 10px 0 0; font-size: 14.5px; line-height: 1.85; color: var(--ink-2); }
  .r-cap { margin: 12px 0 0; font-size: 10.5px; letter-spacing: 0.1em; color: var(--ink-2); }
  .q-chip {
    font-size: 13px;
    color: var(--ink);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 8px 16px;
  }

  /* taste board */
  .taste {
    background: var(--paper, #FFFDF8);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    padding: 22px;
    box-shadow: 0 24px 50px -32px rgba(44, 36, 24, 0.35);
  }
  .t-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .t-tile { display: block; aspect-ratio: 4 / 3; border-radius: 8px; }
  .t1 { background: linear-gradient(160deg, #E6562E, #8E2F4B); }
  .t2 { background: linear-gradient(200deg, #2B1B45, #C56A4A); }
  .t3 { background: linear-gradient(150deg, #F0B47A, #B65CC9); }
  .t4 { background: linear-gradient(180deg, #1A2C45, #4796E3); }
  .t5 { background: linear-gradient(140deg, #2E2A26, #A89F8D); }
  .t6 { background: linear-gradient(170deg, #D85A8A, #5F7FE8); }
  .t-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .t-tags .q-chip { font-size: 11.5px; padding: 5px 12px; }

  /* map card */
  .mapcard {
    background: var(--paper, #FFFDF8);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    padding: 22px;
    box-shadow: 0 24px 50px -32px rgba(44, 36, 24, 0.35);
  }
  .map { position: relative; height: 170px; }
  .m-you {
    position: absolute;
    left: 14%;
    bottom: 18%;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--ink);
  }
  .m-path {
    position: absolute;
    left: 19%;
    bottom: 26%;
    width: 58%;
    border-top: 2px dashed var(--accent);
    transform: rotate(-24deg);
    transform-origin: left bottom;
  }
  .m-spot {
    position: absolute;
    right: 16%;
    top: 22%;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2.5px solid var(--accent);
    box-shadow: 0 0 0 5px rgba(240, 147, 122, 0.18);
  }
  .m-label { position: absolute; font-size: 10.5px; letter-spacing: 0.08em; color: var(--ink-2); }
  .l-you { left: 10%; bottom: 4%; }
  .l-spot { right: 6%; top: 6%; color: var(--accent); }
  .map-meta {
    margin: 12px 0 0;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink);
    border-top: 1px solid var(--hairline);
    padding-top: 12px;
  }

  /* settings dial */
  .dial {
    background: var(--paper, #FFFDF8);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    padding: 24px 26px;
    box-shadow: 0 24px 50px -32px rgba(44, 36, 24, 0.35);
  }
  .fc-head {
    margin: 0 0 14px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .dial-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }
  .d-item {
    border: 1px solid var(--hairline);
    border-radius: 10px;
    padding: 12px 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
  }
  .d-k { font-size: 9.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-2); }
  .d-v { font-family: var(--serif); font-size: clamp(15px, 2vw, 20px); color: var(--ink); }

  /* grade recipe */
  .grade {
    background: var(--paper, #FFFDF8);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    padding: 22px 26px;
    box-shadow: 0 24px 50px -32px rgba(44, 36, 24, 0.35);
  }
  .g-strip {
    height: 14px;
    border-radius: 7px;
    background: linear-gradient(90deg, #8E8B86, #B0937C, #D88E5A, #E6562E);
  }
  .g-rows { margin-top: 8px; }
  .g-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
