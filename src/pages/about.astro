---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/ui';

const lang = 'en' as const;
const skills = ['AI agents', 'LLM orchestration', 'Python', 'TypeScript', 'Product design', 'Review gates'];
---

<Base lang={lang} title="About — Shaw X" description="AI-native coder and designer across brands and creative products.">
  <Nav lang={lang} />
  <main class="container about">
    <p class="section-label">{t(lang, 'about.title')} <span class="idx">/02</span></p>
    <div class="grid">
      <img class="photo-img" src="/about/portrait-about.jpg" alt="Shaw" />
      <div class="bio">
        <h1>Shaw X</h1>
        <p>
          "X" is an intersection. Not a variable — a crossing. The place where two lines meet
          and something new appears.
        </p>
        <p>
          I grew up in China developing two instincts in parallel: how things work, and whether
          they're worth looking at. I've held both without apology ever since. I believe the most
          honest work happens at edges — where engineering discipline and designed restraint reach
          the same answer from opposite directions.
        </p>
        <p>
          I code because precision is a form of respect. I design because aesthetics is not
          decoration — it is judgment made visible. The two are not in tension — they are the
          same demand made in different languages.
        </p>
        <p>
          Art is how I calibrate. I photograph, collect things made with care, and let beauty
          stay honest about what I value. That sense of color, rhythm, and restraint shows up
          in everything I ship.
        </p>
        <p>The X is where I live.</p>
        <div class="art-row">
          <img src="/about/art-1.jpg" alt="Roses in low light, shot by Shaw" loading="lazy" />
          <img src="/about/art-3.jpg" alt="Backlit roses, shot by Shaw" loading="lazy" />
          <img src="/about/art-2.jpg" alt="Roses and shadows on a warm wall, shot by Shaw" loading="lazy" />
        </div>
        <h2 class="sub mono">Skills</h2>
        <div class="tags">
          {skills.map((s) => <span class="tag mono">{s}</span>)}
        </div>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .about { padding: 130px 24px 40px; }
  .grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 48px;
    margin-top: 30px;
  }
  @media (max-width: 768px) {
    .grid { grid-template-columns: 1fr; }
  }
  .photo-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 12px;
  }
  .art-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 18px;
    max-width: 640px;
  }
  .art-row img {
    width: 100%;
    height: 210px;
    object-fit: cover;
    border-radius: 10px;
  }
  @media (max-width: 600px) {
    .art-row { grid-template-columns: 1fr; }
    .art-row img { height: 200px; }
  }
  .bio h1 { font-size: clamp(40px, 6vw, 64px); }
  .bio p { color: var(--ink); max-width: 560px; }
  .sub {
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 36px;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .tag {
    font-size: 12px;
    color: var(--ink-2);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 4px 12px;
  }
</style>
