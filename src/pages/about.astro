---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/ui';

const lang = 'en' as const;
const skills = ['AI agents', 'LLM orchestration', 'Python', 'TypeScript', 'Product design', 'Review gates'];
---

<Base lang={lang} title="About — Shaw X" description="Independent engineer with taste and product sense.">
  <Nav lang={lang} />
  <main class="container about">
    <p class="section-label">{t(lang, 'about.title')} <span class="idx">/02</span></p>
    <div class="grid">
      <img class="photo-img" src="/about/portrait.jpg" alt="Shaw" />
      <div class="bio">
        <h1>Shaw X</h1>
        <p>
          I'm Shaw — an independent engineer with range: architecture, product decisions, pixels,
          and the review gates that keep everything honest. I have my own ideas about how things
          should work, and stronger ones about how they should look.
        </p>
        <p>
          Right now I'm building TaxGlobal AI, a tax assistant where the rules engine is the single
          source of truth and the LLM never gets to guess. In 2026 I ranked #2 in the world on
          Mithra's timed CRM build challenge.
        </p>
        <p>
          Art is my other home. It's where my sense of color, rhythm and restraint comes from — I
          collect things made with taste, and I try to ship like that.
        </p>
        <div class="art-row">
          <img src="/about/art-1.jpg" alt="Roses in low light, shot by Shaw" loading="lazy" />
          <img src="/about/art-3.jpg" alt="Backlit roses, shot by Shaw" loading="lazy" />
          <img src="/about/art-2.jpg" alt="Roses and shadows on a warm wall, shot by Shaw" loading="lazy" />
        </div>
        <h2 class="sub mono">Skills</h2>
        <div class="tags">
          {skills.map((s) => <span class="tag mono">{s}</span>)}
        </div>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .about { padding: 130px 24px 40px; }
  .grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 48px;
    margin-top: 30px;
  }
  @media (max-width: 768px) {
    .grid { grid-template-columns: 1fr; }
  }
  .photo-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 12px;
  }
  .art-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 18px;
    max-width: 640px;
  }
  .art-row img {
    width: 100%;
    height: 210px;
    object-fit: cover;
    border-radius: 10px;
  }
  @media (max-width: 600px) {
    .art-row { grid-template-columns: 1fr; }
    .art-row img { height: 200px; }
  }
  .bio h1 { font-size: clamp(40px, 6vw, 64px); }
  .bio p { color: var(--ink); max-width: 560px; }
  .sub {
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 36px;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .tag {
    font-size: 12px;
    color: var(--ink-2);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 4px 12px;
  }
</style>
