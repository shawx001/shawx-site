---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { t } from '../i18n/ui';

const lang = 'en' as const;
---

<Base lang={lang} title="404 — Shaw X" description="Page not found.">
  <Nav lang={lang} />
  <main class="nf">
    <img src="/favicon.svg" alt="" width="72" height="72" aria-hidden="true" />
    <h1>{t(lang, 'notfound.title')}</h1>
    <p class="mono zh-line">迷失在粒子里了。</p>
    <a class="back mono" href="/">{t(lang, 'notfound.back')} →</a>
  </main>
</Base>

<style>
  .nf {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    text-align: center;
    padding: 0 24px;
  }
  h1 { font-size: clamp(34px, 5vw, 56px); }
  .zh-line { margin: 0; font-size: 13px; color: var(--ink-2); }
  .back {
    font-size: 13px;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 10px 24px;
  }
  .back:hover { background: var(--accent); color: var(--bg); }
</style>
