---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CopilotDemo from '../../components/CopilotDemo.astro';
import CopilotFilm from '../../components/CopilotFilm.astro';

const lang = 'en' as const;
---

<Base
  lang={lang}
  title="AI Camera Copilot — Shaw X"
  description="A photography copilot that learns your taste — where to stand, how to frame, what to dial in."
>
  <Nav lang={lang} />
  <main class="container case">
    <a class="back mono" href="/#work">← Selected work</a>

    <header class="head">
      <h1>AI Camera Copilot</h1>
      <p class="lede">
        A photography copilot that learns your taste — then walks you to the shot:
        where to stand, how to frame, what to dial in.
      </p>
    </header>

    <div class="meta">
      <div class="meta-item">
        <span class="meta-label mono">Context</span>
        <span class="meta-value">Independent product<br />2026 · in design</span>
      </div>
      <div class="meta-item">
        <span class="meta-label mono">My role</span>
        <span class="meta-value">Founder — product,<br />design, architecture</span>
      </div>
      <div class="meta-item">
        <span class="meta-label mono">Status</span>
        <span class="meta-value">Experience designed,<br />prototype next</span>
      </div>
    </div>

    <figure class="shot">
      <img src="/case/camera/p-hero.jpg" alt="Shooting a portrait by the waterfront while the copilot suggests: step left slightly, raise the camera a bit — subject placement good, leading lines strong, composition 85" width="1400" height="788" />
      <figcaption class="mono">live guidance — step left, raise the camera, exposure dialed</figcaption>
    </figure>

    <section class="block">
      <p class="b-label mono">01 — Overview</p>
      <h2>Everyone has taste. Not everyone has technique.</h2>
      <p>
        You know exactly which photos you love — you just can't always take them.
        The gap between the photo you see and the photo you get is technique:
        position, framing, light, settings. Camera Copilot starts from the photos
        you wish you'd shot, learns your aesthetic, and closes that gap — frame
        by frame.
      </p>
    </section>

    <section class="block">
      <p class="b-label mono">02 — How it works</p>
      <h2>Show it your taste. It does the rest.</h2>
      <div class="steps">
        <div class="step">
          <span class="s-num">1</span>
          <h3>Show it your taste</h3>
          <p>The photos you love — yours or anyone's — become the brief.</p>
        </div>
        <div class="step">
          <span class="s-num">2</span>
          <h3>It reads the scene</h3>
          <p>Light, subject, geometry — understood in real time, as you raise the camera.</p>
        </div>
        <div class="step">
          <span class="s-num">3</span>
          <h3>It walks you there</h3>
          <p>Position, framing, settings — dialed before you press the shutter.</p>
        </div>
      </div>
      <CopilotDemo lang={lang} />
    </section>

    <section class="block">
      <p class="b-label mono">03 — Features</p>
      <h2>Six things it does for your eye.</h2>

      <div class="feature">
        <div class="f-text">
          <h3>Learns your eye</h3>
          <p>
            Upload the photos you love. It distills them into an aesthetic profile,
            then matches what you're seeing to the shot you wish you'd taken —
            and tells you exactly how to close the gap.
          </p>
        </div>
        <figure class="f-visual">
          <img src="/case/camera/p-match.jpg" alt="Phone showing a target shot from your taste profile next to the live view, matched at 94 percent, with pan, tilt and zoom suggestions" width="1400" height="788" loading="lazy" />
        </figure>
      </div>

      <div class="feature flip">
        <div class="f-text">
          <h3>Walks you to the shot</h3>
          <p>
            Not just "nice scene" — composition guides live in the frame, with the
            next move spelled out: step left, get lower, wait for the light.
          </p>
        </div>
        <figure class="f-visual">
          <img src="/case/camera/p-guide.jpg" alt="Camera rear screen at golden hour with level, subject and composition checks passed and the suggestion: move slightly left for stronger balance" width="1400" height="788" loading="lazy" />
        </figure>
      </div>

      <div class="feature">
        <div class="f-text">
          <h3>Dials it in</h3>
          <p>
            ISO, aperture, shutter, white balance — set for the exact shot you're
            about to take. One tap to apply, or full manual if you'd rather turn
            the dials yourself.
          </p>
        </div>
        <figure class="f-visual">
          <img src="/case/camera/p-night.jpg" alt="Night street shooting with the copilot dialing manual settings: 1/160, f/1.8, ISO 800 — face detected, composition 82" width="1400" height="788" loading="lazy" />
        </figure>
      </div>

      <div class="feature flip">
        <div class="f-text">
          <h3>Grades like you</h3>
          <p>
            Edits arrive as a recipe in your taste — crop, light, color, subject —
            with a before and after you can judge at a glance.
          </p>
        </div>
        <figure class="f-visual">
          <img src="/case/camera/grade.svg" alt="Tablet showing before-and-after color grading with the recipe: warmth +12, contrast +8, shadows lifted, grain 6" width="1600" height="900" loading="lazy" />
        </figure>
      </div>

      <div class="feature">
        <div class="f-text">
          <h3>Pro cameras welcome</h3>
          <p>
            Pairs with real bodies, reads RAW and speaks manual. Shots sync to a
            review desk where the copilot flags the keepers.
          </p>
        </div>
        <figure class="f-visual">
          <img src="/case/camera/p-desk.jpg" alt="The copilot's desktop review desk on a laptop, beside a pro camera body and drone controller — missions, flight paths and suggested edits in one place" width="1400" height="788" loading="lazy" />
        </figure>
      </div>

      <div class="feature flip">
        <div class="f-text">
          <h3>Drone autopilot</h3>
          <p>
            Finding the angle is the boring part of flying. The copilot scouts the
            orbit, picks the altitude and frames the shot — you just approve.
          </p>
        </div>
        <figure class="f-visual">
          <img src="/case/camera/p-mission.jpg" alt="Drone mission console with a 3D terrain map, orbit waypoints plotted around the peak, 85mm at 120m — ready to send the mission" width="1400" height="788" loading="lazy" />
        </figure>
      </div>
    </section>

    <CopilotFilm lang={lang} />

    <section class="block">
      <p class="b-label mono">04 — What it covers</p>
      <h2>One eye, every kind of shot.</h2>
      <div class="goals three">
        <div class="goal">
          <span class="g-num mono">24mm</span>
          <h3>Street</h3>
          <p>Settings pre-dialed so the moment never waits for a menu.</p>
        </div>
        <div class="goal">
          <span class="g-num mono">85mm</span>
          <h3>Portrait</h3>
          <p>Light on faces, posing distance, lens compression — handled.</p>
        </div>
        <div class="goal">
          <span class="g-num mono">16mm</span>
          <h3>Landscape</h3>
          <p>Horizons, foreground anchors and golden-hour timing.</p>
        </div>
        <div class="goal">
          <span class="g-num mono">30s</span>
          <h3>Night</h3>
          <p>Long-exposure math without the trial and error.</p>
        </div>
        <div class="goal">
          <span class="g-num mono">42m</span>
          <h3>Aerial</h3>
          <p>Orbits and altitudes scouted before you even take off.</p>
        </div>
        <div class="goal">
          <span class="g-num mono">RAW</span>
          <h3>Any camera</h3>
          <p>Phone, mirrorless, drone — one taste profile across every body.</p>
        </div>
      </div>
    </section>

    <figure class="band">
      <img src="/case/camera/p-water.jpg" alt="At a dusk waterfront, the copilot matches reference photos to the scene and plans the flight path while the drone hovers over the subject" width="1400" height="788" loading="lazy" />
      <figcaption class="mono">reference matched, path planned — same eye after dark</figcaption>
    </figure>

    <p class="tbc"><span class="tbc-dots">…</span>To be continued</p>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .case { padding: 130px 24px 90px; max-width: 880px; }
  .back {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
    transition: color 0.25s;
  }
  .back:hover { color: var(--accent); }
  .head { margin-top: 34px; }
  .head h1 { font-size: clamp(40px, 6.4vw, 72px); }
  .lede {
    margin: 18px 0 0;
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 640px;
  }
  .meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 52px;
    padding: 28px 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .meta-item { display: flex; flex-direction: column; gap: 8px; }
  .meta-label {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .meta-value { font-size: 14px; line-height: 1.6; color: var(--ink); }

  /* hero shot + full-width band */
  .shot { margin: 56px 0 0; }
  .shot img, .band img {
    width: 100%;
    height: auto;
    border-radius: 18px;
    display: block;
    box-shadow: 0 36px 80px -42px rgba(44, 36, 24, 0.55);
  }
  .band { margin: 88px 0 0; }
  .shot figcaption, .band figcaption {
    margin-top: 14px;
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-2);
  }

  .block { margin-top: 88px; }
  .b-label {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .block h2 { margin-top: 12px; font-size: clamp(26px, 3.6vw, 38px); }
  .block > p {
    margin: 18px 0 0;
    font-size: 15.5px;
    line-height: 1.8;
    color: var(--ink);
    max-width: 660px;
  }

  /* editorial steps */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 4vw, 44px);
    margin-top: 36px;
    border-top: 1px solid var(--hairline);
    padding-top: 32px;
  }
  .s-num {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(38px, 5vw, 56px);
    line-height: 1;
    color: var(--accent);
  }
  .step h3 { font-size: 18px; margin-top: 14px; }
  .step p { margin: 8px 0 0; font-size: 13.5px; line-height: 1.7; color: var(--ink-2); }

  /* features */
  .feature {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    margin-top: 64px;
  }
  .feature.flip .f-text { order: 2; }
  .feature.flip .f-visual { order: 1; }
  .f-text h3 { font-size: clamp(20px, 2.6vw, 26px); }
  .f-text p { margin: 10px 0 0; font-size: 14.5px; line-height: 1.75; color: var(--ink-2); }
  .f-visual { margin: 0; }
  .f-visual img {
    width: 100%;
    height: auto;
    border-radius: 14px;
    display: block;
    box-shadow: 0 28px 60px -36px rgba(44, 36, 24, 0.5);
  }

  /* coverage grid */
  .goals {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 28px;
  }
  .goals.three { grid-template-columns: repeat(3, 1fr); }
  .goal { border: 1px solid var(--hairline); border-radius: 14px; padding: 22px 22px 20px; }
  .g-num {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .goal h3 { font-size: 18px; margin-top: 10px; }
  .goal p { margin: 8px 0 0; font-size: 13px; line-height: 1.65; color: var(--ink-2); }

  .tbc {
    margin: 130px 0 30px;
    text-align: center;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(30px, 4.5vw, 48px);
    letter-spacing: 0.01em;
    color: var(--ink);
  }
  .tbc-dots { color: var(--accent); margin-right: 0.18em; }

  @media (max-width: 720px) {
    .meta { grid-template-columns: 1fr; gap: 20px; }
    .goals, .goals.three { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr; gap: 28px; }
    .block { margin-top: 64px; }
    .band { margin-top: 64px; }
    .feature { grid-template-columns: 1fr; gap: 18px; margin-top: 48px; }
    .feature.flip .f-text { order: 1; }
    .feature.flip .f-visual { order: 2; }
  }
</style>
