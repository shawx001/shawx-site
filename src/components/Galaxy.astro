---
import { t, type Lang } from '../i18n/ui';

export interface GalaxyItem {
  title: string;
  cover: string;
  link?: string | undefined;
}
interface Props {
  items: GalaxyItem[];
  lang: Lang;
}
const { items, lang } = Astro.props;
const COLORS = ['#4796E3', '#8E64D8', '#D85A8A', '#E0705A'];
---

<div class="galaxy" data-galaxy data-reveal>
  <svg class="rings" viewBox="0 0 1000 460" preserveAspectRatio="none" aria-hidden="true">
    <ellipse cx="500" cy="230" rx="480" ry="170" fill="none" stroke="#B9A28C" stroke-width="1" opacity="0.5"></ellipse>
    <ellipse cx="500" cy="230" rx="400" ry="140" fill="none" stroke="#B9A28C" stroke-width="1" opacity="0.22"></ellipse>
    <g fill="#B9A28C" opacity="0.6">
      <circle cx="130" cy="80" r="1.6"></circle>
      <circle cx="870" cy="60" r="1.2"></circle>
      <circle cx="940" cy="330" r="1.5"></circle>
      <circle cx="60" cy="300" r="1.2"></circle>
      <circle cx="780" cy="400" r="1.4"></circle>
    </g>
  </svg>

  <div class="stage">
    {
      items.map((it, i) => (
        <figure class={`slide${i === 0 ? ' active' : ''}`} data-slide={i}>
          {it.link ? (
            <a href={it.link} target="_blank" rel="noopener">
              <img src={it.cover} alt={it.title} width="1200" height="630" loading={i === 0 ? 'eager' : 'lazy'} />
            </a>
          ) : (
            <img src={it.cover} alt={it.title} width="1200" height="630" loading={i === 0 ? 'eager' : 'lazy'} />
          )}
        </figure>
      ))
    }
  </div>

  {
    items.map((it, i) => (
      <button class={`planet${i === 0 ? ' active' : ''}`} data-planet={i} type="button" aria-label={it.title}>
        <span class="orb" style={`--pc: ${COLORS[i % COLORS.length]}`}></span>
        <span class="plabel mono">{it.title}</span>
      </button>
    ))
  }

  <div class="caption">
    {
      items.map((it, i) => (
        <div class={`cap${i === 0 ? ' active' : ''}`} data-cap={i}>
          <h3 class="cap-title">{it.title}</h3>
          {it.link ? (
            <a class="chip mono live" href={it.link} target="_blank" rel="noopener">{t(lang, 'work.live')}</a>
          ) : (
            <span class="chip mono">{t(lang, 'work.soon')}</span>
          )}
        </div>
      ))
    }
  </div>
</div>

<style>
  .galaxy {
    position: relative;
    height: clamp(440px, 58vw, 640px);
  }
  .rings {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: calc(100% - 92px);
  }
  .stage {
    position: absolute;
    left: 50%;
    top: calc((100% - 92px) / 2);
    transform: translate(-50%, -50%);
    width: min(58%, 560px);
    z-index: 50;
  }
  .slide {
    margin: 0;
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(0.96);
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
  }
  .slide.active {
    position: relative;
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .slide img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 18px;
    box-shadow: 0 30px 70px -30px rgba(44, 36, 24, 0.5);
  }
  .planet {
    position: absolute;
    left: 0;
    top: 0;
    background: none;
    border: 0;
    padding: 6px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    will-change: transform;
  }
  .orb {
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 28%, rgba(255, 255, 255, 0.92), var(--pc) 55%, color-mix(in srgb, var(--pc), #000 38%) 100%);
    box-shadow: 0 0 14px 2px color-mix(in srgb, var(--pc), transparent 45%);
    transition: box-shadow 0.3s;
  }
  .planet:hover .orb,
  .planet.active .orb {
    box-shadow: 0 0 24px 6px color-mix(in srgb, var(--pc), transparent 28%);
  }
  .plabel {
    font-size: 11px;
    color: var(--ink-2);
    opacity: 0;
    transition: opacity 0.3s;
    white-space: nowrap;
  }
  .planet:hover .plabel,
  .planet.active .plabel {
    opacity: 1;
  }
  .caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 92px;
    display: grid;
    place-items: center;
  }
  .cap {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    gap: 16px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.45s ease, transform 0.45s ease;
  }
  .cap.active {
    opacity: 1;
    transform: none;
  }
  .cap-title {
    font-size: clamp(22px, 2.6vw, 30px);
  }
  .chip {
    flex-shrink: 0;
    font-size: 12px;
    color: var(--ink-2);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 5px 14px;
  }
  .chip.live {
    color: var(--accent);
    border-color: var(--accent);
  }
  .chip.live:hover {
    background: var(--accent);
    color: var(--bg);
  }
</style>

<script>
  function initGalaxies() {
    document.querySelectorAll('[data-galaxy]').forEach((rootEl) => {
      const root = rootEl as HTMLElement;
      const planets = [...root.querySelectorAll('[data-planet]')] as HTMLElement[];
      const slides = [...root.querySelectorAll('[data-slide]')] as HTMLElement[];
      const caps = [...root.querySelectorAll('[data-cap]')] as HTMLElement[];
      const n = planets.length;
      if (!n) return;

      const TAU = Math.PI * 2;
      const FRONT = Math.PI / 2;
      const step = TAU / n;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let rot = FRONT;
      let target = FRONT;

      const select = (i: number) => {
        const desired = FRONT - i * step;
        let d = desired - target;
        d = ((((d + Math.PI) % TAU) + TAU) % TAU) - Math.PI;
        target += d;
        slides.forEach((s, j) => s.classList.toggle('active', j === i));
        caps.forEach((c, j) => c.classList.toggle('active', j === i));
        planets.forEach((p, j) => p.classList.toggle('active', j === i));
      };
      planets.forEach((p, i) => p.addEventListener('click', () => select(i)));

      let rafId = 0;
      const frame = (now: number) => {
        rafId = requestAnimationFrame(frame);
        if (document.hidden) return;
        const w = root.clientWidth;
        const ringH = root.clientHeight - 92;
        const cx = w / 2;
        const cy = ringH / 2;
        const rx = w * 0.48;
        const ry = ringH * 0.37;
        rot += (target - rot) * (reduced ? 1 : 0.07);
        const tsec = now / 1000;
        planets.forEach((p, i) => {
          const a = i * step + rot;
          const bob = reduced ? 0 : Math.sin(tsec * 1.3 + i * 2.1) * 4;
          const x = cx + Math.cos(a) * rx;
          const y = cy + Math.sin(a) * ry + bob;
          const depth = (Math.sin(a) + 1) / 2;
          const s = 0.62 + depth * 0.58;
          p.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%) scale(${s})`;
          p.style.zIndex = String(Math.round(depth * 100));
          p.style.opacity = String(0.45 + depth * 0.55);
        });
      };
      rafId = requestAnimationFrame(frame);
      window.addEventListener('pagehide', () => cancelAnimationFrame(rafId));
    });
  }
  initGalaxies();
</script>
