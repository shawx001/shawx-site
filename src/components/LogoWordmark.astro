---
interface Props {
  variant?: 'totem' | 'wide' | 'seal';
  compact?: boolean;
  class?: string;
}

const {
  variant = 'totem',
  compact = false,
  class: cls = '',
} = Astro.props;
---

<span class={`relief-logo relief-${variant} ${compact ? 'is-compact' : ''} ${cls}`} aria-label="Shaw X">
  {variant === 'totem' && (
    <svg viewBox="0 0 320 680" role="img">
      <title>Shaw X carved vertical relief logo</title>
      <defs>
        <filter id="rl-soft-shadow" x="-20%" y="-20%" width="160%" height="160%">
          <feGaussianBlur in="SourceAlpha" stdDeviation="9" result="blur" />
          <feOffset dx="28" dy="12" result="offset" />
          <feColorMatrix
            in="offset"
            type="matrix"
            values="0 0 0 0 0.05 0 0 0 0 0.12 0 0 0 0 0.13 0 0 0 0.48 0"
          />
          <feMerge>
            <feMergeNode />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
        <filter id="rl-inner" x="-10%" y="-10%" width="130%" height="130%">
          <feDropShadow dx="-7" dy="-6" stdDeviation="3.2" flood-color="#fff4c7" flood-opacity="0.8" />
          <feDropShadow dx="7" dy="8" stdDeviation="4" flood-color="#1d3333" flood-opacity="0.42" />
        </filter>
        <linearGradient id="rl-paper" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#efe6bd" />
          <stop offset="0.48" stop-color="#e5d9aa" />
          <stop offset="0.5" stop-color="#718783" />
          <stop offset="1" stop-color="#516d6a" />
        </linearGradient>
        <radialGradient id="rl-light" cx="24%" cy="12%" r="78%">
          <stop offset="0" stop-color="#fff8cc" stop-opacity="0.72" />
          <stop offset="0.52" stop-color="#f3e9bd" stop-opacity="0.18" />
          <stop offset="1" stop-color="#496865" stop-opacity="0" />
        </radialGradient>
      </defs>

      <rect width="320" height="680" rx="0" fill="url(#rl-paper)" />
      <rect width="320" height="680" fill="url(#rl-light)" />
      <path class="rl-seam" d="M142 62 V618" />
      <g class="rl-shadow" filter="url(#rl-soft-shadow)">
        <text x="152" y="146">S</text>
        <text x="152" y="250">H</text>
        <text x="152" y="356">A</text>
        <text x="152" y="462">W</text>
        <text x="152" y="575">X</text>
      </g>
      <g class="rl-cut" filter="url(#rl-inner)">
        <text x="142" y="136">S</text>
        <text x="142" y="240">H</text>
        <text x="142" y="346">A</text>
        <text x="142" y="452">W</text>
        <text x="142" y="565">X</text>
      </g>
      <g class="rl-bevels">
        <path d="M111 163 H181 L159 181 H93 Z" />
        <path d="M104 270 H190 L166 289 H83 Z" />
        <path d="M98 377 H190 L162 396 H78 Z" />
        <path d="M94 484 H195 L165 504 H72 Z" />
        <path d="M101 597 H188 L157 617 H80 Z" />
      </g>
    </svg>
  )}

  {variant === 'wide' && (
    <svg viewBox="0 0 760 260" role="img">
      <title>Shaw X horizontal carved relief logo</title>
      <defs>
        <filter id="rw-shadow" x="-20%" y="-30%" width="160%" height="180%">
          <feGaussianBlur in="SourceAlpha" stdDeviation="10" result="blur" />
          <feOffset dx="34" dy="14" result="offset" />
          <feColorMatrix
            in="offset"
            type="matrix"
            values="0 0 0 0 0.05 0 0 0 0 0.11 0 0 0 0 0.12 0 0 0 0.5 0"
          />
          <feMerge>
            <feMergeNode />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
        <filter id="rw-inner" x="-10%" y="-20%" width="130%" height="150%">
          <feDropShadow dx="-8" dy="-7" stdDeviation="3" flood-color="#fff3c2" flood-opacity="0.86" />
          <feDropShadow dx="8" dy="8" stdDeviation="4" flood-color="#213737" flood-opacity="0.42" />
        </filter>
        <linearGradient id="rw-paper" x1="0" x2="1">
          <stop offset="0" stop-color="#f0e7bd" />
          <stop offset="0.5" stop-color="#e6dbad" />
          <stop offset="0.505" stop-color="#6f8581" />
          <stop offset="1" stop-color="#516c69" />
        </linearGradient>
      </defs>
      <rect width="760" height="260" fill="url(#rw-paper)" />
      <path class="rl-seam" d="M382 24 V236" />
      <g class="rw-word" filter="url(#rw-shadow)">
        <text x="382" y="162" text-anchor="middle">SHAW X</text>
      </g>
      <g class="rw-word rw-cut" filter="url(#rw-inner)">
        <text x="364" y="150" text-anchor="middle">SHAW X</text>
      </g>
    </svg>
  )}

  {variant === 'seal' && (
    <svg viewBox="0 0 320 320" role="img">
      <title>Shaw X compact carved seal logo</title>
      <defs>
        <filter id="rs-shadow" x="-25%" y="-25%" width="170%" height="170%">
          <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blur" />
          <feOffset dx="22" dy="12" result="offset" />
          <feColorMatrix
            in="offset"
            type="matrix"
            values="0 0 0 0 0.05 0 0 0 0 0.11 0 0 0 0 0.12 0 0 0 0.48 0"
          />
          <feMerge>
            <feMergeNode />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
        <filter id="rs-inner" x="-15%" y="-15%" width="140%" height="140%">
          <feDropShadow dx="-7" dy="-6" stdDeviation="3" flood-color="#fff4c7" flood-opacity="0.84" />
          <feDropShadow dx="7" dy="8" stdDeviation="4" flood-color="#1d3333" flood-opacity="0.44" />
        </filter>
        <linearGradient id="rs-paper" x1="0" x2="1">
          <stop offset="0" stop-color="#efe6bd" />
          <stop offset="0.51" stop-color="#e5d9aa" />
          <stop offset="0.515" stop-color="#6e8581" />
          <stop offset="1" stop-color="#526d69" />
        </linearGradient>
      </defs>
      <rect width="320" height="320" fill="url(#rs-paper)" />
      <path class="rl-seam" d="M142 34 V286" />
      <g class="rs-mark" filter="url(#rs-shadow)">
        <text x="151" y="188" text-anchor="middle">SX</text>
      </g>
      <g class="rs-mark rs-cut" filter="url(#rs-inner)">
        <text x="140" y="176" text-anchor="middle">SX</text>
      </g>
    </svg>
  )}
</span>

<style>
  .relief-logo {
    display: inline-flex;
    width: min(100%, 320px);
    color: #ede2b4;
  }

  .relief-wide {
    width: min(100%, 760px);
  }

  .relief-seal {
    width: min(100%, 320px);
  }

  .relief-logo.is-compact {
    width: 92px;
  }

  .relief-logo svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
    box-shadow: 0 24px 80px rgba(37, 47, 43, 0.24);
  }

  .rl-seam {
    fill: none;
    stroke: rgba(48, 68, 66, 0.38);
    stroke-width: 1.4;
  }

  .rl-shadow text,
  .rl-cut text,
  .rw-word text,
  .rs-mark text {
    font-family: Inter, Arial, sans-serif;
    font-weight: 900;
    letter-spacing: -0.08em;
  }

  .rl-shadow text,
  .rl-cut text {
    font-size: 114px;
    dominant-baseline: middle;
    text-anchor: middle;
  }

  .rw-word text {
    font-size: 118px;
    letter-spacing: -0.055em;
  }

  .rs-mark text {
    font-size: 132px;
    letter-spacing: -0.1em;
  }

  .rl-shadow,
  .rw-word,
  .rs-mark {
    fill: rgba(31, 54, 54, 0.2);
  }

  .rl-cut,
  .rw-cut,
  .rs-cut {
    fill: #eadfb2;
  }

  .rl-bevels {
    fill: rgba(255, 244, 196, 0.34);
    filter: blur(0.3px);
  }
</style>
