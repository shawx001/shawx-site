---
// 「副驾对齐一张目标构图」 10s 循环 · 纯 CSS
// 视觉 = 产品渲染图同款 App UI(深色 + 科技绿),照片为真实摄影
// 节奏: Slow(界面) - Fast(live view 平移对齐) - 悬停 - Boom(96%+快门) - 定格
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const T = {
  en: {
    pan: 'Move right',
    tilt: 'Tilt up slightly',
    zoom: 'Zoom in a bit',
    badge: '✓ Saved · in your taste',
    cap: 'live view, matched to your taste — in ten seconds',
    aria: 'Animated demo: the app compares your target shot with the live view, suggests pan right, tilt up and zoom 1.2x; the live view drifts into alignment, the match ring climbs from 64 to 96 percent and the shot is saved',
  },
  zh: {
    pan: '向右移',
    tilt: '稍微上抬',
    zoom: '拉近一点',
    badge: '✓ 已保存 · 是你的味道',
    cap: '实时取景，对齐你的审美 —— 十秒钟',
    aria: '动画演示：App 将目标构图与实时取景比对，建议右移、上抬、拉近 1.2 倍；取景画面缓缓对齐，匹配度从 64% 爬到 96%，照片保存',
  },
}[lang];
---

<div class="demo" role="img" aria-label={T.aria}>
  <div class="backdrop" aria-hidden="true"></div>

  <div class="phone">
    <div class="screen">
      <div class="statusbar mono"><span>7:42</span><span class="sig">●●●</span></div>
      <div class="titlebar"><span class="tb-back">‹</span><span class="tb-title">AI Camera Copilot</span><span class="tb-gear">⚙</span></div>

      <p class="panel-label mono">TARGET SHOT</p>
      <div class="shot target">
        <img src="/bg/dusk.jpg" alt="" loading="lazy" />
      </div>

      <p class="panel-label mono lv-label">LIVE VIEW</p>
      <div class="shot live">
        <img class="live-img" src="/bg/dusk.jpg" alt="" loading="lazy" />
        <div class="lv-grid" aria-hidden="true"></div>
        <span class="match">
          <svg viewBox="0 0 44 44" aria-hidden="true">
            <circle class="ring-bg" cx="22" cy="22" r="18"/>
            <circle class="ring" cx="22" cy="22" r="18"/>
          </svg>
          <span class="nums mono">
            <i class="s s64">64%</i><i class="s s78">78%</i><i class="s s91">91%</i><i class="s s96">96%</i>
          </span>
        </span>
        <span class="lv-flash" aria-hidden="true"></span>
        <span class="badge mono">{T.badge}</span>
      </div>

      <div class="rows">
        <div class="row r1"><span class="r-k">Pan</span><span class="r-v mono">{T.pan} →</span></div>
        <div class="row r2"><span class="r-k">Tilt</span><span class="r-v mono">{T.tilt} ↑</span></div>
        <div class="row r3"><span class="r-k">Zoom</span><span class="r-v mono">{T.zoom} 1.2×</span></div>
      </div>

      <div class="dock">
        <span class="d-ico" aria-hidden="true">⊕</span>
        <span class="shutter" aria-hidden="true"></span>
        <span class="d-ico" aria-hidden="true">≑</span>
      </div>
    </div>
  </div>
</div>
<p class="demo-cap mono">{T.cap}</p>

<style>
  /* expoOut ≈ cubic-bezier(.16,1,.3,1) · overshoot ≈ cubic-bezier(.34,1.56,.64,1) */
  .demo {
    --t: 10s;
    --hud: #58D87E;
    --hud-glow: rgba(88, 216, 126, 0.4);
    --app: #101312;
    --app-2: #1A1E1C;
    --app-line: rgba(255, 255, 255, 0.09);
    position: relative;
    margin-top: 44px;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    overflow: hidden;
    background: #150D26;
    box-shadow: 0 36px 80px -42px rgba(44, 36, 24, 0.55);
    display: grid;
    place-items: center;
    container-type: size;
    font-size: clamp(7px, 1.05vw, 10.5px);
  }
  .demo-cap {
    margin: 14px 0 0;
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-2);
  }
  .backdrop {
    position: absolute;
    inset: -24px;
    background: url('/bg/dusk.jpg') center 38% / cover no-repeat;
    filter: blur(14px) saturate(1.12) brightness(0.78);
  }
  .demo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 100% at 50% 50%, transparent 55%, rgba(10, 6, 16, 0.55));
    pointer-events: none;
  }

  /* —— 手机 —— */
  .phone {
    position: relative;
    z-index: 2;
    height: 94cqh;
    aspect-ratio: 9 / 18.6;
    border-radius: 2.6em;
    background: #060807;
    padding: 0.55em;
    box-shadow: 0 30px 70px -28px rgba(0, 0, 0, 0.75), 0 0 0 1.5px rgba(255, 255, 255, 0.1);
    animation: phoneIn var(--t) cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  @keyframes phoneIn {
    0% { opacity: 0; transform: translateY(14px) scale(0.985); }
    7%, 100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  .screen {
    height: 100%;
    border-radius: 2.1em;
    background: var(--app);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 0.9em 1.1em 1em;
    color: rgba(255, 255, 255, 0.92);
  }

  .statusbar {
    display: flex;
    justify-content: space-between;
    font-size: 0.78em;
    color: rgba(255, 255, 255, 0.75);
    letter-spacing: 0.08em;
    padding: 0.2em 0.4em 0;
  }
  .sig { letter-spacing: 0.18em; font-size: 0.6em; line-height: 2; }
  .titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55em 0.2em 0.75em;
    border-bottom: 1px solid var(--app-line);
  }
  .tb-title { font-size: 0.95em; font-weight: 600; letter-spacing: 0.02em; }
  .tb-back, .tb-gear { color: rgba(255, 255, 255, 0.6); font-size: 1.1em; }

  .panel-label {
    margin: 0.9em 0.2em 0.45em;
    font-size: 0.62em;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.48);
  }

  /* —— 照片面板 —— */
  .shot {
    position: relative;
    border-radius: 0.8em;
    overflow: hidden;
    background: var(--app-2);
  }
  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .target { aspect-ratio: 16 / 6.6; animation: targetIn var(--t) cubic-bezier(0.16, 1, 0.3, 1) infinite; }
  .target img { object-position: 50% 34%; }
  @keyframes targetIn {
    0%, 8% { opacity: 0; transform: translateY(8px); }
    14%, 100% { opacity: 1; transform: translateY(0); }
  }
  .lv-label { animation: targetIn var(--t) cubic-bezier(0.16, 1, 0.3, 1) infinite; }

  .live { aspect-ratio: 16 / 10.2; animation: liveIn var(--t) cubic-bezier(0.16, 1, 0.3, 1) infinite; }
  @keyframes liveIn {
    0%, 14% { opacity: 0; transform: translateY(8px); }
    20%, 100% { opacity: 1; transform: translateY(0); }
  }
  /* live view 画面:从"偏了"缓缓对齐 target 构图 */
  .live-img {
    object-position: 50% 34%;
    transform: translate(-5.5%, 4.5%) scale(1.22);
    animation: align var(--t) cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  @keyframes align {
    0%, 30% { transform: translate(-5.5%, 4.5%) scale(1.22); }
    72%, 100% { transform: translate(0, 0) scale(1.02); }
  }
  .lv-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.14) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.14) 1px, transparent 1px);
    background-size: 33.4% 33.4%;
    background-position: -1px -1px;
  }

  /* —— 匹配度仪表 —— */
  .match {
    position: absolute;
    top: 0.7em;
    right: 0.7em;
    width: 3.6em;
    aspect-ratio: 1;
    animation: matchIn var(--t) cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  @keyframes matchIn {
    0%, 21% { opacity: 0; transform: scale(0.8); }
    26%, 100% { opacity: 1; transform: scale(1); }
  }
  .match svg { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
  .ring-bg { fill: rgba(6, 8, 7, 0.72); stroke: rgba(255, 255, 255, 0.18); stroke-width: 3.5; }
  .ring {
    fill: none;
    stroke: var(--hud);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-dasharray: 113;
    filter: drop-shadow(0 0 4px var(--hud-glow));
    animation: ringFill var(--t) cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  /* offset = 113*(1-p) · 64→78→91→悬停→96 */
  @keyframes ringFill {
    0%, 26% { stroke-dashoffset: 113; }
    32% { stroke-dashoffset: 40.7; }
    52% { stroke-dashoffset: 24.9; }
    70% { stroke-dashoffset: 10.2; }
    77% { stroke-dashoffset: 10.2; }
    81%, 100% { stroke-dashoffset: 4.5; }
  }
  .nums {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 0.82em;
    color: #fff;
  }
  .s { font-style: normal; grid-area: 1 / 1; opacity: 0; }
  .s64 { animation: s64 var(--t) steps(1) infinite; }
  .s78 { animation: s78 var(--t) steps(1) infinite; }
  .s91 { animation: s91 var(--t) steps(1) infinite; }
  .s96 { color: var(--hud); animation: s96 var(--t) cubic-bezier(0.34, 1.56, 0.64, 1) infinite; }
  @keyframes s64 { 0%, 25% { opacity: 0; } 26%, 51% { opacity: 1; } 52%, 100% { opacity: 0; } }
  @keyframes s78 { 0%, 51% { opacity: 0; } 52%, 69% { opacity: 1; } 70%, 100% { opacity: 0; } }
  @keyframes s91 { 0%, 69% { opacity: 0; } 70%, 79% { opacity: 1; } 80%, 100% { opacity: 0; } }
  @keyframes s96 {
    0%, 79% { opacity: 0; transform: scale(0.7); }
    82% { opacity: 1; transform: scale(1.16); }
    85%, 100% { opacity: 1; transform: scale(1); }
  }

  /* —— 快门闪 + 保存徽章 —— */
  .lv-flash {
    position: absolute;
    inset: 0;
    background: #fff;
    animation: lvFlash var(--t) ease-out infinite;
  }
  @keyframes lvFlash {
    0%, 79.5% { opacity: 0; }
    80.5% { opacity: 0.5; }
    82%, 100% { opacity: 0; }
  }
  .badge {
    position: absolute;
    left: 50%;
    bottom: 0.8em;
    transform: translateX(-50%);
    white-space: nowrap;
    padding: 0.5em 1.1em;
    border-radius: 0.6em;
    background: rgba(6, 8, 7, 0.78);
    border: 1px solid var(--hud);
    color: var(--hud);
    font-size: 0.74em;
    letter-spacing: 0.08em;
    backdrop-filter: blur(4px);
    animation: badgePop var(--t) cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
  }
  @keyframes badgePop {
    0%, 81% { opacity: 0; transform: translateX(-50%) scale(0.7); }
    85% { opacity: 1; transform: translateX(-50%) scale(1.06); }
    88%, 100% { opacity: 1; transform: translateX(-50%) scale(1); }
  }

  /* —— 建议行:stagger 入场 —— */
  .rows { margin-top: 0.9em; border-top: 1px solid var(--app-line); }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6em 0.3em;
    border-bottom: 1px solid var(--app-line);
    font-size: 0.82em;
    animation: rowIn var(--t) cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  .r2 { animation-delay: 0.14s; }
  .r3 { animation-delay: 0.28s; }
  .r-k { color: rgba(255, 255, 255, 0.78); }
  .r-v { color: var(--hud); letter-spacing: 0.04em; }
  @keyframes rowIn {
    0%, 26% { opacity: 0; transform: translateY(8px); }
    33%, 100% { opacity: 1; transform: translateY(0); }
  }

  /* —— 底部 dock —— */
  .dock {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding-top: 0.7em;
  }
  .d-ico { color: rgba(255, 255, 255, 0.55); font-size: 1.15em; }
  .shutter {
    width: 3.2em;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #F2F0EA;
    box-shadow: 0 0 0 0.28em rgba(255, 255, 255, 0.25);
    animation: shutterPress var(--t) ease-in-out infinite;
  }
  @keyframes shutterPress {
    0%, 78% { transform: scale(1); }
    80% { transform: scale(0.88); }
    82%, 100% { transform: scale(1); }
  }

  /* 减少动效:定格最终画面 */
  @media (prefers-reduced-motion: reduce) {
    .demo *, .demo { animation: none !important; }
    .phone { opacity: 1; transform: none; }
    .target, .lv-label, .live, .row, .match { opacity: 1; transform: none; }
    .live-img { transform: translate(0, 0) scale(1.02); }
    .ring { stroke-dashoffset: 4.5; }
    .s64, .s78, .s91 { opacity: 0; }
    .s96 { opacity: 1; transform: none; }
    .lv-flash { opacity: 0; }
    .badge { opacity: 1; transform: translateX(-50%) scale(1); }
  }
</style>
