---
import { t, type Lang } from '../i18n/ui';

export interface WorkItem {
  title: string;
  summary: string;
  link?: string | undefined;
  casePath?: string | undefined;
}
interface Props {
  items: WorkItem[];
  lang: Lang;
}
const { items, lang } = Astro.props;
---

<div class="work-list">
  {
    items.map((it, i) => (
      <div class="row" data-reveal>
        <span class="idx mono">{String(i + 1).padStart(2, '0')}</span>
        <div class="mid">
          <h3 class="title">
            {it.casePath ? (
              <a class="case-link" href={it.casePath}>{it.title}</a>
            ) : (
              it.title
            )}
          </h3>
          <p class="summary">{it.summary}</p>
        </div>
        {it.link ? (
          <a class="chip mono live" href={it.link} target="_blank" rel="noopener">{t(lang, 'work.live')}</a>
        ) : it.casePath ? (
          <a class="chip mono live" href={it.casePath}>{t(lang, 'work.case')}</a>
        ) : (
          <span class="chip mono">{t(lang, 'work.soon')}</span>
        )}
      </div>
    ))
  }
</div>

<style>
  .work-list { margin-top: 14px; }
  .row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 32px 0;
    border-top: 1px solid var(--wl-line, var(--hairline));
  }
  .row:last-child { border-bottom: 1px solid var(--wl-line, var(--hairline)); }
  .idx { font-size: 13px; color: var(--wl-accent, var(--accent)); min-width: 2.2ch; }
  .mid { flex: 1; min-width: 0; }
  .title {
    font-size: clamp(28px, 4vw, 44px);
    color: var(--wl-title, var(--ink));
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .case-link { color: inherit; }
  .case-link::after { content: ''; position: absolute; inset: 0; }
  .row:hover .title { transform: translateX(10px); }
  .summary {
    margin: 4px 0 0;
    font-size: 13.5px;
    color: var(--wl-muted, var(--ink-2));
    max-width: 520px;
  }
  .chip {
    flex-shrink: 0;
    position: relative;
    z-index: 2;
    font-size: 12px;
    color: var(--wl-muted, var(--ink-2));
    border: 1px solid var(--wl-line, var(--hairline));
    border-radius: 999px;
    padding: 5px 14px;
  }
  .chip.live { color: var(--wl-accent, var(--accent)); border-color: var(--wl-accent, var(--accent)); }
  .chip.live:hover { background: var(--wl-accent, var(--accent)); color: #1A112E; }
  @media (max-width: 820px) {
    .row { gap: 16px; padding: 26px 0; }
    .row:hover .title { transform: none; }
  }
</style>
