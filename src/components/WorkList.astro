---
import { t, type Lang } from '../i18n/ui';

export interface WorkItem {
  title: string;
  summary: string;
  cover: string;
  link?: string | undefined;
}
interface Props {
  items: WorkItem[];
  lang: Lang;
}
const { items, lang } = Astro.props;
---

<div class="work-list">
  {
    items.map((it, i) => (
      <div class="row" data-reveal>
        <span class="idx mono">{String(i + 1).padStart(2, '0')}</span>
        <div class="mid">
          <h3 class="title">{it.title}</h3>
          <p class="summary">{it.summary}</p>
        </div>
        {it.link ? (
          <a class="chip mono live" href={it.link} target="_blank" rel="noopener">{t(lang, 'work.live')}</a>
        ) : (
          <span class="chip mono">{t(lang, 'work.soon')}</span>
        )}
        <img class="preview" src={it.cover} alt="" loading="lazy" width="1200" height="630" />
      </div>
    ))
  }
</div>

<style>
  .work-list { margin-top: 14px; }
  .row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 32px 0;
    border-top: 1px solid var(--hairline);
  }
  .row:last-child { border-bottom: 1px solid var(--hairline); }
  .idx { font-size: 13px; color: var(--accent); min-width: 2.2ch; }
  .mid { flex: 1; min-width: 0; }
  .title {
    font-size: clamp(28px, 4vw, 44px);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .row:hover .title { transform: translateX(10px); }
  .summary {
    margin: 4px 0 0;
    font-size: 13.5px;
    color: var(--ink-2);
    max-width: 520px;
  }
  .chip {
    flex-shrink: 0;
    font-size: 12px;
    color: var(--ink-2);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 5px 14px;
  }
  .chip.live { color: var(--accent); border-color: var(--accent); }
  .chip.live:hover { background: var(--accent); color: var(--bg); }
  .preview {
    position: absolute;
    right: 140px;
    top: 50%;
    width: 300px;
    height: auto;
    border-radius: 12px;
    opacity: 0;
    transform: translateY(-46%) rotate(-3deg) scale(0.96);
    transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
    z-index: 5;
    box-shadow: 0 24px 60px -24px rgba(44, 36, 24, 0.5);
  }
  .row:hover .preview {
    opacity: 1;
    transform: translateY(-50%) rotate(-2deg) scale(1);
  }
  @media (max-width: 820px) {
    .preview { display: none; }
    .row { gap: 16px; padding: 26px 0; }
    .row:hover .title { transform: none; }
  }
</style>
