---
// 「自动定位 · 飞到 reference 的角度」 14s 循环演示 · 纯 CSS
// 构图 = 真实场景(人+无人机)背景里的一台笔记本:
// 屏幕左侧 = TARGET SHOT(参考构图) + 任务状态 + 航线小地图(无人机移动)
// 屏幕右侧 = 无人机实时画面,从完全不同的取景逐渐收敛到与参考图一致
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const T = {
  en: {
    ref: 'TARGET SHOT · reference',
    live: 'LIVE · drone feed',
    s1: 'Locating the angle…',
    s2: 'Flight path set — flying',
    s3: 'Angle matched',
    matched: '✓ ANGLE MATCHED',
    cap: 'auto-locate — the drone flies itself to the reference angle',
    aria: 'Demo: on a laptop by the water, the left panel holds a reference photo while the right panel streams the drone live feed; the drone locates the angle, flies the plotted path on the minimap as distance counts down from 86 meters, and the live view converges until it matches the reference — 100 percent, angle matched',
  },
  zh: {
    ref: '目标构图 · 参考图',
    live: '实时 · 无人机画面',
    s1: '正在定位角度…',
    s2: '航线已规划 —— 飞行中',
    s3: '角度已对齐',
    matched: '✓ 角度已对齐',
    cap: '自动定位 —— 无人机自己飞到 reference 的角度',
    aria: '演示：水边的笔记本上，左侧面板是一张参考照片，右侧面板是无人机实时回传；无人机定位角度后沿小地图航线飞行，距离从 86 米倒数，实时画面逐渐收敛直至与参考图完全一致 —— 匹配 100%，角度对齐',
  },
}[lang];
---

<figure class="loc" role="img" aria-label={T.aria}>
  <div class="bg" aria-hidden="true"></div>

  <div class="laptop">
    <div class="lscreen">
      <div class="lbar mono">
        <span class="lb-left"><i class="gdot"></i>AI CAMERA COPILOT · MISSION 04</span>
        <span class="lb-right"><i class="rdot"></i>REC · ⛀ 87%</span>
      </div>
      <div class="lbody">
        <div class="lleft">
          <div class="panel ref">
            <img src="/bg/dusk.jpg" alt="" loading="lazy" />
            <span class="p-tag mono">{T.ref}</span>
          </div>
          <div class="steps mono">
            <span class="st st1"><i class="st-dot"></i>{T.s1}</span>
            <span class="st st2"><i class="st-dot"></i>{T.s2}</span>
            <span class="st st3"><i class="st-dot"></i>{T.s3}</span>
          </div>
          <div class="mini" aria-hidden="true">
            <svg viewBox="0 0 100 64" preserveAspectRatio="none">
              <path class="route" d="M12 52 Q34 50 52 36 T88 14" fill="none"/>
            </svg>
            <span class="m-home"></span>
            <span class="m-target"></span>
            <span class="m-uav"></span>
          </div>
        </div>
        <div class="lright">
          <div class="panel live">
            <div class="live-crop">
              <img class="live-img" src="/bg/dusk.jpg" alt="" loading="lazy" />
            </div>
            <div class="lv-grid" aria-hidden="true"></div>
            <span class="p-tag mono"><i class="rdot"></i>{T.live}</span>
            <span class="ring-wrap">
              <svg viewBox="0 0 44 44" aria-hidden="true">
                <circle class="ring-bg" cx="22" cy="22" r="18"/>
                <circle class="ring" cx="22" cy="22" r="18"/>
              </svg>
              <span class="nums mono">
                <i class="n n58">58%</i><i class="n n72">72%</i><i class="n n86">86%</i><i class="n n93">93%</i><i class="n n100">100%</i>
              </span>
            </span>
            <span class="dist mono">DIST
              <span class="dn d1">86 m</span><span class="dn d2">61 m</span><span class="dn d3">42 m</span><span class="dn d4">27 m</span><span class="dn d5">14 m</span><span class="dn d6">6 m</span><span class="dn d7">2 m</span><span class="dn d8">0 m</span>
            </span>
            <span class="lflash" aria-hidden="true"></span>
            <span class="matched mono">{T.matched}</span>
          </div>
        </div>
      </div>
    </div>
    <div class="lbase"></div>
  </div>
</figure>
<p class="loc-cap mono">{T.cap}</p>

<style>
  .loc {
    --t: 14s;
    --hud: #58D87E;
    --hud-glow: rgba(88, 216, 126, 0.4);
    --glass-line: rgba(255, 255, 255, 0.12);
    position: relative;
    margin: 88px 0 0;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    overflow: hidden;
    background: #0E0816;
    box-shadow: 0 36px 80px -42px rgba(44, 36, 24, 0.55);
    display: grid;
    place-items: center;
    container-type: size;
    font-size: clamp(7px, 1.1cqw, 12px);
  }
  .loc-cap {
    margin: 14px 0 0;
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-2);
  }
  .bg {
    position: absolute;
    inset: -20px;
    background: url('/case/camera/p-locate.jpg') center 30% / cover no-repeat;
    filter: blur(10px) brightness(0.62) saturate(1.05);
  }
  .loc::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 105% at 50% 46%, transparent 52%, rgba(8, 5, 14, 0.6));
    pointer-events: none;
  }

  /* —— 笔记本 —— */
  .laptop {
    position: relative;
    z-index: 2;
    width: 80cqw;
    animation: lapIn var(--t) cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  @keyframes lapIn {
    0% { opacity: 0; transform: translateY(12px) scale(0.99); }
    5%, 100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  .lscreen {
    background: #0C0F0D;
    border: 1.5px solid rgba(255, 255, 255, 0.13);
    border-bottom: none;
    border-radius: 1.1em 1.1em 0 0;
    padding: 1em 1.2em 1.2em;
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.8);
  }
  .lbase {
    height: 1.05em;
    background: linear-gradient(#2A2E2B, #151816);
    border-radius: 0 0 1.2em 1.2em;
    box-shadow: 0 14px 30px -14px rgba(0, 0, 0, 0.8);
  }
  .lbase::after {
    content: '';
    display: block;
    width: 16%;
    height: 38%;
    margin: 0 auto;
    background: #0B0D0C;
    border-radius: 0 0 0.6em 0.6em;
  }

  .lbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.2em 0.2em 0.9em;
    font-size: 0.82em;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.85);
  }
  .lb-left, .lb-right { display: inline-flex; align-items: center; gap: 0.6em; }
  .gdot { width: 0.55em; height: 0.55em; border-radius: 50%; background: var(--hud); box-shadow: 0 0 8px var(--hud-glow); }
  .rdot {
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: #FF5A4E;
    animation: blink 1.2s steps(2, jump-none) infinite;
  }
  @keyframes blink { 0% { opacity: 1; } 100% { opacity: 0.25; } }

  .lbody {
    display: grid;
    grid-template-columns: 1fr 2.2fr;
    gap: 1em;
  }
  .lleft { display: flex; flex-direction: column; gap: 0.9em; min-width: 0; }
  .lright { min-width: 0; }

  /* —— 面板通用 —— */
  .panel {
    position: relative;
    border-radius: 0.7em;
    overflow: hidden;
    background: #161A17;
    border: 1px solid var(--glass-line);
  }
  .panel img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .p-tag {
    position: absolute;
    top: 0.7em;
    left: 0.7em;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.35em 0.8em;
    border-radius: 0.45em;
    background: rgba(6, 8, 7, 0.72);
    border: 1px solid var(--glass-line);
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.66em;
    letter-spacing: 0.16em;
    backdrop-filter: blur(4px);
    white-space: nowrap;
  }

  /* —— 参考图:最终构图(静态) + 对齐瞬间绿框脉冲 —— */
  .ref { aspect-ratio: 16 / 10; }
  .ref img { object-position: 50% 38%; }
  .ref { animation: refPulse var(--t) ease infinite; }
  @keyframes refPulse {
    0%, 76% { border-color: var(--glass-line); box-shadow: none; }
    80%, 92% { border-color: var(--hud); box-shadow: 0 0 18px var(--hud-glow); }
    100% { border-color: var(--glass-line); }
  }

  /* —— 任务状态 —— */
  .steps { display: flex; flex-direction: column; gap: 0.55em; font-size: 0.74em; letter-spacing: 0.1em; }
  .st { display: inline-flex; align-items: center; gap: 0.7em; color: rgba(255, 255, 255, 0.45); }
  .st-dot { width: 0.5em; height: 0.5em; border-radius: 50%; background: currentColor; flex-shrink: 0; }
  .st1 { animation: st1 var(--t) steps(1) infinite; }
  .st2 { animation: st2 var(--t) steps(1) infinite; }
  .st3 { animation: st3 var(--t) steps(1) infinite; }
  @keyframes st1 { 0%, 7% { color: rgba(255,255,255,0.45); } 8%, 21% { color: #fff; } 22%, 100% { color: rgba(255,255,255,0.45); } }
  @keyframes st2 { 0%, 21% { color: rgba(255,255,255,0.45); } 22%, 75% { color: #fff; } 76%, 100% { color: rgba(255,255,255,0.45); } }
  @keyframes st3 { 0%, 76% { color: rgba(255,255,255,0.45); } 77%, 100% { color: #58D87E; } }

  /* —— 航线小地图:无人机沿路径移动 —— */
  .mini {
    position: relative;
    flex: 1;
    min-height: 5.5em;
    border-radius: 0.7em;
    background: #11140F;
    border: 1px solid var(--glass-line);
    overflow: hidden;
  }
  .mini svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .route {
    stroke: var(--hud);
    stroke-width: 1.6;
    stroke-dasharray: 4 5;
    opacity: 0.7;
    animation: routeIn var(--t) cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  @keyframes routeIn {
    0%, 9% { opacity: 0; }
    14%, 100% { opacity: 0.7; }
  }
  .m-home {
    position: absolute;
    left: 10%;
    top: 78%;
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.7);
    transform: translate(-50%, -50%);
  }
  .m-target {
    position: absolute;
    left: 88%;
    top: 22%;
    width: 0.9em;
    height: 0.9em;
    border-radius: 50%;
    border: 1.5px solid var(--hud);
    transform: translate(-50%, -50%);
    animation: targetPulse var(--t) ease infinite;
  }
  @keyframes targetPulse {
    0%, 76% { box-shadow: none; background: transparent; }
    80%, 100% { box-shadow: 0 0 12px var(--hud-glow); background: var(--hud); }
  }
  /* 无人机点:沿 (10,78)->(52,56)->(88,22) 的弧线 */
  .m-uav {
    position: absolute;
    left: 10%;
    top: 78%;
    width: 0.62em;
    height: 0.62em;
    border-radius: 50%;
    background: var(--hud);
    box-shadow: 0 0 10px var(--hud-glow);
    transform: translate(-50%, -50%);
    animation: uavFly var(--t) ease-in-out infinite;
  }
  @keyframes uavFly {
    0%, 20% { left: 10%; top: 78%; }
    38% { left: 38%; top: 62%; }
    52% { left: 56%; top: 50%; }
    64% { left: 74%; top: 34%; }
    72%, 100% { left: 88%; top: 22%; }
  }

  /* —— 实时画面:从错位取景收敛到与参考一致 —— */
  .live { aspect-ratio: 16 / 9.7; }
  .live-crop { position: absolute; inset: 0; overflow: hidden; }
  .live-img {
    position: absolute;
    inset: 0;
    object-position: 50% 38%;
    transform: scale(1.62) translate(11%, 9%) rotate(2.6deg);
    animation: converge var(--t) cubic-bezier(0.45, 0.05, 0.25, 1) infinite;
  }
  @keyframes converge {
    0%, 16% { transform: scale(1.62) translate(11%, 9%) rotate(2.6deg); }
    40% { transform: scale(1.34) translate(5.5%, 4.5%) rotate(1.3deg); }
    72%, 100% { transform: scale(1.0) translate(0, 0) rotate(0deg); }
  }
  .lv-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.09) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.09) 1px, transparent 1px);
    background-size: 33.4% 33.4%;
    background-position: -1px -1px;
  }

  /* —— 匹配环 —— */
  .ring-wrap {
    position: absolute;
    top: 0.7em;
    right: 0.7em;
    width: 3.8em;
    aspect-ratio: 1;
    animation: ringIn var(--t) cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  @keyframes ringIn {
    0%, 12% { opacity: 0; transform: scale(0.85); }
    17%, 100% { opacity: 1; transform: scale(1); }
  }
  .ring-wrap svg { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
  .ring-bg { fill: rgba(6, 8, 7, 0.74); stroke: rgba(255, 255, 255, 0.18); stroke-width: 3.5; }
  .ring {
    fill: none;
    stroke: var(--hud);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-dasharray: 113;
    filter: drop-shadow(0 0 4px var(--hud-glow));
    animation: ringFill var(--t) cubic-bezier(0.45, 0.05, 0.25, 1) infinite;
  }
  /* offset = 113*(1-p): 58→72→86→93→悬停→100 */
  @keyframes ringFill {
    0%, 16% { stroke-dashoffset: 47.5; }
    40% { stroke-dashoffset: 31.6; }
    58% { stroke-dashoffset: 15.8; }
    70% { stroke-dashoffset: 7.9; }
    76% { stroke-dashoffset: 7.9; }
    80%, 100% { stroke-dashoffset: 0; }
  }
  .nums {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 0.78em;
    color: #fff;
  }
  .n { font-style: normal; grid-area: 1 / 1; opacity: 0; }
  .n58 { animation: n58 var(--t) steps(1) infinite; }
  .n72 { animation: n72 var(--t) steps(1) infinite; }
  .n86 { animation: n86 var(--t) steps(1) infinite; }
  .n93 { animation: n93 var(--t) steps(1) infinite; }
  .n100 { color: var(--hud); animation: n100 var(--t) cubic-bezier(0.34, 1.56, 0.64, 1) infinite; }
  @keyframes n58 { 0%, 39% { opacity: 1; } 40%, 100% { opacity: 0; } }
  @keyframes n72 { 0%, 39% { opacity: 0; } 40%, 57% { opacity: 1; } 58%, 100% { opacity: 0; } }
  @keyframes n86 { 0%, 57% { opacity: 0; } 58%, 69% { opacity: 1; } 70%, 100% { opacity: 0; } }
  @keyframes n93 { 0%, 69% { opacity: 0; } 70%, 78% { opacity: 1; } 79%, 100% { opacity: 0; } }
  @keyframes n100 {
    0%, 78% { opacity: 0; transform: scale(0.7); }
    81% { opacity: 1; transform: scale(1.15); }
    84%, 100% { opacity: 1; transform: scale(1); }
  }

  /* —— 距离倒数 —— */
  .dist {
    position: absolute;
    left: 0.7em;
    bottom: 0.7em;
    padding: 0.35em 0.8em;
    border-radius: 0.45em;
    background: rgba(6, 8, 7, 0.72);
    border: 1px solid var(--glass-line);
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.7em;
    letter-spacing: 0.14em;
    backdrop-filter: blur(4px);
  }
  .dn { position: absolute; left: 4.2em; top: 0.35em; color: #fff; opacity: 0; font-style: normal; }
  .dn:first-of-type { position: static; padding-left: 0.5em; }
  .d1 { animation: dk1 var(--t) steps(1) infinite; }
  .d2 { animation: dk2 var(--t) steps(1) infinite; }
  .d3 { animation: dk3 var(--t) steps(1) infinite; }
  .d4 { animation: dk4 var(--t) steps(1) infinite; }
  .d5 { animation: dk5 var(--t) steps(1) infinite; }
  .d6 { animation: dk6 var(--t) steps(1) infinite; }
  .d7 { animation: dk7 var(--t) steps(1) infinite; }
  .d8 { animation: dk8 var(--t) steps(1) infinite; }
  @keyframes dk1 { 0%, 27% { opacity: 1; } 28%, 100% { opacity: 0; } }
  @keyframes dk2 { 0%, 27% { opacity: 0; } 28%, 38% { opacity: 1; } 39%, 100% { opacity: 0; } }
  @keyframes dk3 { 0%, 38% { opacity: 0; } 39%, 48% { opacity: 1; } 49%, 100% { opacity: 0; } }
  @keyframes dk4 { 0%, 48% { opacity: 0; } 49%, 57% { opacity: 1; } 58%, 100% { opacity: 0; } }
  @keyframes dk5 { 0%, 57% { opacity: 0; } 58%, 64% { opacity: 1; } 65%, 100% { opacity: 0; } }
  @keyframes dk6 { 0%, 64% { opacity: 0; } 65%, 70% { opacity: 1; } 71%, 100% { opacity: 0; } }
  @keyframes dk7 { 0%, 70% { opacity: 0; } 71%, 75% { opacity: 1; } 76%, 100% { opacity: 0; } }
  @keyframes dk8 { 0%, 75% { opacity: 0; } 76%, 100% { opacity: 1; } }

  /* —— 对齐瞬间:闪光 + 徽章 —— */
  .lflash {
    position: absolute;
    inset: 0;
    background: #fff;
    animation: lFlash var(--t) ease-out infinite;
  }
  @keyframes lFlash {
    0%, 78.5% { opacity: 0; }
    79.5% { opacity: 0.45; }
    81%, 100% { opacity: 0; }
  }
  .matched {
    position: absolute;
    left: 50%;
    bottom: 0.9em;
    transform: translateX(-50%);
    padding: 0.5em 1.2em;
    border-radius: 0.5em;
    background: var(--hud);
    color: #0B1410;
    font-weight: 600;
    font-size: 0.78em;
    letter-spacing: 0.14em;
    white-space: nowrap;
    box-shadow: 0 0 24px var(--hud-glow);
    animation: matchedPop var(--t) cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
  }
  @keyframes matchedPop {
    0%, 80% { opacity: 0; transform: translateX(-50%) scale(0.7); }
    84% { opacity: 1; transform: translateX(-50%) scale(1.07); }
    87%, 100% { opacity: 1; transform: translateX(-50%) scale(1); }
  }

  /* 减少动效:定格已对齐画面 */
  @media (prefers-reduced-motion: reduce) {
    .loc * { animation: none !important; }
    .laptop { opacity: 1; transform: none; }
    .live-img { transform: scale(1) translate(0, 0) rotate(0); }
    .ring { stroke-dashoffset: 0; }
    .n { opacity: 0; }
    .n100 { opacity: 1; transform: none; }
    .dn { opacity: 0; }
    .d8 { opacity: 1; }
    .st3 { color: #58D87E; }
    .m-uav { left: 88%; top: 22%; }
    .lflash { opacity: 0; }
    .matched { opacity: 1; transform: translateX(-50%) scale(1); }
  }
</style>
