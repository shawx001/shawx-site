---
// 「无人机环绕实拍演示」 16s 一镜到底循环 · 纯 CSS
// 真实照片做机位画面,连续飞行漂移 + DJI 式遥测 HUD + 小地图环绕航线
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const T = {
  en: {
    mode: 'ORBIT · AUTO',
    lock: 'SUBJECT LOCKED',
    done: '✓ 3 angles saved',
    cap: 'drone autopilot — one continuous take',
    aria: 'Continuous drone demo: the camera feed drifts through a golden cloud sea while telemetry ticks — altitude around 42 meters, heading sweeping through the orbit — and on the minimap the drone circles the subject; at the end three angles are saved',
  },
  zh: {
    mode: 'ORBIT · 自动',
    lock: '主体已锁定',
    done: '✓ 已存 3 个角度',
    cap: '无人机自动驾驶 —— 一镜到底',
    aria: '无人机连续演示：镜头在金色云海上缓慢飞行，遥测实时跳动 —— 高度约 42 米，航向随环绕扫过 —— 小地图上无人机绕主体转圈，结尾保存 3 个角度',
  },
}[lang];
---

<figure class="fpv" role="img" aria-label={T.aria}>
  <div class="feed" aria-hidden="true"></div>
  <div class="vig" aria-hidden="true"></div>

  <!-- 三分线 -->
  <div class="fgrid" aria-hidden="true"></div>

  <!-- 顶部:REC + 标题 + 电量 -->
  <div class="hud top mono">
    <span class="rec"><i class="rdot"></i>REC
      <span class="tnums"><i class="tn t1">00:02</i><i class="tn t2">00:04</i><i class="tn t3">00:06</i><i class="tn t4">00:08</i><i class="tn t5">00:10</i><i class="tn t6">00:12</i><i class="tn t7">00:14</i><i class="tn t8">00:16</i></span>
    </span>
    <span class="title">AI CAMERA COPILOT · DRONE</span>
    <span class="batt">⛀ 87% · GPS 14</span>
  </div>

  <!-- 中心:目标锁定框 -->
  <span class="lockbox" aria-hidden="true">
    <i class="lk tl"></i><i class="lk tr"></i><i class="lk bl"></i><i class="lk br"></i>
  </span>
  <span class="locktag mono">{T.lock}</span>

  <!-- 左下:遥测 -->
  <div class="hud tele mono">
    <span class="t-row">ALT
      <span class="tnums"><i class="tn a1">41.8 m</i><i class="tn a2">42.0 m</i><i class="tn a3">42.3 m</i><i class="tn a4">42.1 m</i><i class="tn a5">42.6 m</i><i class="tn a6">42.4 m</i><i class="tn a7">42.2 m</i><i class="tn a8">42.0 m</i></span>
    </span>
    <span class="t-row">SPD <b>3.2 m/s</b></span>
    <span class="t-row">HDG
      <span class="tnums"><i class="tn h1">132°</i><i class="tn h2">156°</i><i class="tn h3">180°</i><i class="tn h4">204°</i><i class="tn h5">228°</i><i class="tn h6">252°</i><i class="tn h7">276°</i><i class="tn h8">300°</i></span>
    </span>
  </div>

  <!-- 底中:模式 chip + 完成 toast -->
  <span class="mode mono">{T.mode}</span>
  <span class="done mono">{T.done}</span>

  <!-- 右下:小地图,无人机沿轨道环绕 -->
  <div class="map" aria-hidden="true">
    <span class="m-ring"></span>
    <span class="m-subject"></span>
    <span class="m-orbit">
      <span class="m-drone"><i class="m-fov"></i></span>
    </span>
  </div>
</figure>
<p class="fpv-cap mono">{T.cap}</p>

<style>
  .fpv {
    --t: 16s;
    --hud: #58D87E;
    --hud-glow: rgba(88, 216, 126, 0.4);
    position: relative;
    margin: 88px 0 0;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    overflow: hidden;
    background: #0E0816;
    box-shadow: 0 36px 80px -42px rgba(44, 36, 24, 0.55);
    font-size: clamp(9px, 1.4vw, 13.5px);
  }
  .fpv-cap {
    margin: 14px 0 0;
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-2);
  }

  /* —— 机位画面:连续飞行漂移(首尾相接无缝循环) —— */
  .feed {
    position: absolute;
    inset: -6%;
    background: url('/bg/dusk.jpg') center 42% / cover no-repeat;
    animation: fly var(--t) ease-in-out infinite;
  }
  @keyframes fly {
    0% { transform: scale(1.16) translate(2.6%, 1.6%); }
    50% { transform: scale(1.08) translate(-2.4%, -1.2%); }
    100% { transform: scale(1.16) translate(2.6%, 1.6%); }
  }
  .vig {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(8, 6, 14, 0.5), transparent 18%),
      linear-gradient(to top, rgba(8, 6, 14, 0.55), transparent 26%),
      radial-gradient(115% 100% at 50% 50%, transparent 60%, rgba(8, 6, 14, 0.4));
  }
  .fgrid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.09) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.09) 1px, transparent 1px);
    background-size: 33.4% 33.4%;
    background-position: -1px -1px;
  }

  .hud { position: absolute; z-index: 3; color: rgba(255, 255, 255, 0.92); }
  .hud.top {
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2em 1.6em;
    font-size: 0.86em;
    letter-spacing: 0.14em;
  }
  .rec { display: inline-flex; align-items: center; gap: 0.6em; }
  .rdot {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: #FF5A4E;
    animation: blink 1.2s steps(2, jump-none) infinite;
  }
  @keyframes blink { 0% { opacity: 1; } 100% { opacity: 0.25; } }
  .title { opacity: 0.85; }
  .batt { opacity: 0.85; }

  /* —— 跳动数字:8 帧 steps 交叉 —— */
  .tnums { position: relative; display: inline-block; min-width: 4.6em; }
  .tn { font-style: normal; position: absolute; left: 0.4em; top: 0; opacity: 0; }
  .tn:first-child { position: relative; left: 0; padding-left: 0.4em; }
  .t1, .a1, .h1 { animation: k1 var(--t) steps(1) infinite; }
  .t2, .a2, .h2 { animation: k2 var(--t) steps(1) infinite; }
  .t3, .a3, .h3 { animation: k3 var(--t) steps(1) infinite; }
  .t4, .a4, .h4 { animation: k4 var(--t) steps(1) infinite; }
  .t5, .a5, .h5 { animation: k5 var(--t) steps(1) infinite; }
  .t6, .a6, .h6 { animation: k6 var(--t) steps(1) infinite; }
  .t7, .a7, .h7 { animation: k7 var(--t) steps(1) infinite; }
  .t8, .a8, .h8 { animation: k8 var(--t) steps(1) infinite; }
  @keyframes k1 { 0%, 12.4% { opacity: 1; } 12.5%, 100% { opacity: 0; } }
  @keyframes k2 { 0%, 12.4% { opacity: 0; } 12.5%, 24.9% { opacity: 1; } 25%, 100% { opacity: 0; } }
  @keyframes k3 { 0%, 24.9% { opacity: 0; } 25%, 37.4% { opacity: 1; } 37.5%, 100% { opacity: 0; } }
  @keyframes k4 { 0%, 37.4% { opacity: 0; } 37.5%, 49.9% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @keyframes k5 { 0%, 49.9% { opacity: 0; } 50%, 62.4% { opacity: 1; } 62.5%, 100% { opacity: 0; } }
  @keyframes k6 { 0%, 62.4% { opacity: 0; } 62.5%, 74.9% { opacity: 1; } 75%, 100% { opacity: 0; } }
  @keyframes k7 { 0%, 74.9% { opacity: 0; } 75%, 87.4% { opacity: 1; } 87.5%, 100% { opacity: 0; } }
  @keyframes k8 { 0%, 87.4% { opacity: 0; } 87.5%, 100% { opacity: 1; } }

  /* —— 目标锁定框:中心微调追踪 —— */
  .lockbox {
    position: absolute;
    left: 50%;
    top: 47%;
    width: 17%;
    aspect-ratio: 4 / 3;
    transform: translate(-50%, -50%);
    animation: track var(--t) ease-in-out infinite;
    z-index: 2;
  }
  .lk { position: absolute; width: 1.1em; height: 1.1em; border: 2px solid var(--hud); filter: drop-shadow(0 0 6px var(--hud-glow)); }
  .lk.tl { top: 0; left: 0; border-right: none; border-bottom: none; }
  .lk.tr { top: 0; right: 0; border-left: none; border-bottom: none; }
  .lk.bl { bottom: 0; left: 0; border-right: none; border-top: none; }
  .lk.br { bottom: 0; right: 0; border-left: none; border-top: none; }
  @keyframes track {
    0% { transform: translate(-50%, -50%); }
    18% { transform: translate(-52.5%, -48.5%); }
    41% { transform: translate(-48%, -51.5%); }
    63% { transform: translate(-51%, -49%); }
    84% { transform: translate(-49%, -50.5%); }
    100% { transform: translate(-50%, -50%); }
  }
  .locktag {
    position: absolute;
    left: 50%;
    top: 33.5%;
    transform: translateX(-50%);
    font-size: 0.72em;
    letter-spacing: 0.2em;
    color: var(--hud);
    text-shadow: 0 0 8px var(--hud-glow);
    z-index: 2;
  }

  /* —— 遥测 —— */
  .tele {
    left: 1.6em;
    bottom: 1.4em;
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    font-size: 0.86em;
    letter-spacing: 0.12em;
  }
  .t-row { color: rgba(255, 255, 255, 0.66); }
  .t-row b, .tn { font-weight: 400; color: #fff; }
  .t-row b { padding-left: 0.4em; }

  /* —— 模式 chip / 完成 toast —— */
  .mode {
    position: absolute;
    left: 50%;
    bottom: 7%;
    transform: translateX(-50%);
    padding: 0.55em 1.3em;
    border-radius: 999px;
    background: rgba(8, 6, 14, 0.6);
    border: 1px solid var(--hud);
    color: var(--hud);
    font-size: 0.8em;
    letter-spacing: 0.18em;
    backdrop-filter: blur(5px);
    z-index: 3;
    animation: modeSwap var(--t) ease infinite;
  }
  .done {
    position: absolute;
    left: 50%;
    bottom: 7%;
    transform: translateX(-50%);
    padding: 0.55em 1.3em;
    border-radius: 999px;
    background: var(--hud);
    color: #0B1410;
    font-weight: 600;
    font-size: 0.8em;
    letter-spacing: 0.12em;
    white-space: nowrap;
    box-shadow: 0 0 24px var(--hud-glow);
    z-index: 4;
    animation: doneIn var(--t) cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
  }
  @keyframes modeSwap {
    0%, 86% { opacity: 1; }
    89%, 100% { opacity: 0; }
  }
  @keyframes doneIn {
    0%, 88% { opacity: 0; transform: translateX(-50%) scale(0.7); }
    92% { opacity: 1; transform: translateX(-50%) scale(1.06); }
    94%, 100% { opacity: 1; transform: translateX(-50%) scale(1); }
  }

  /* —— 小地图:无人机连续环绕 —— */
  .map {
    position: absolute;
    right: 1.6em;
    bottom: 1.4em;
    width: clamp(76px, 13%, 110px);
    aspect-ratio: 1;
    border-radius: 12px;
    background: rgba(8, 6, 14, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(5px);
    z-index: 3;
  }
  .m-ring {
    position: absolute;
    inset: 18%;
    border: 1.5px dashed rgba(255, 255, 255, 0.35);
    border-radius: 50%;
  }
  .m-subject {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 7px;
    height: 7px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #fff;
  }
  .m-orbit {
    position: absolute;
    inset: 0;
    animation: orbit var(--t) linear infinite;
  }
  @keyframes orbit {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  .m-drone {
    position: absolute;
    left: 50%;
    top: 18%;
    width: 9px;
    height: 9px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--hud);
    box-shadow: 0 0 8px var(--hud-glow);
  }
  .m-fov {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform: translateX(-50%);
    border-left: 7px solid transparent;
    border-right: 7px solid transparent;
    border-bottom: 16px solid rgba(88, 216, 126, 0.28);
  }

  /* 减少动效:定格带 HUD 的画面 */
  @media (prefers-reduced-motion: reduce) {
    .fpv * { animation: none !important; }
    .tn { opacity: 0; }
    .t1, .a1, .h1 { opacity: 1; }
    .done { opacity: 0; }
    .mode { opacity: 1; }
  }
</style>
