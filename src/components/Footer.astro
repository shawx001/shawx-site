---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const EMAIL = 'shawxiao98918@gmail.com';
const PHONE = '408-304-9841';
---

<footer class="footer" id="contact">
  <div class="container">
    <div class="grid">
      <div class="left">
        <p class="wordmark">Shaw X</p>
        <p class="line">
          {t(lang, 'contact.line')}<br />
          {t(lang, 'contact.line2')}
        </p>
        <a class="connect" href={`mailto:${EMAIL}`}>{t(lang, 'contact.connect')}</a>
      </div>
      <div class="right">
        <div class="item">
          <span class="label">Email</span>
          <a class="value accent" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </div>
        <div class="item">
          <span class="label">Phone</span>
          <a class="value" href="tel:+14083049841">{PHONE}</a>
        </div>
      </div>
    </div>
    <p class="bottom">© 2026 Shaw X. {t(lang, 'footer.note')}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--ft-line, var(--hairline));
    padding: 64px 0 36px;
  }
  .grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 48px;
    flex-wrap: wrap;
  }
  .wordmark {
    margin: 0;
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(30px, 3.6vw, 42px);
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ft-title, var(--ink));
  }
  .line {
    margin: 18px 0 0;
    font-size: 15px;
    line-height: 1.75;
    color: var(--ft-muted, var(--ink-2));
    max-width: 560px;
  }
  .connect {
    display: inline-block;
    margin-top: 26px;
    font-size: 15.5px;
    font-weight: 500;
    color: var(--ft-accent, var(--accent));
    transition: opacity 0.25s;
  }
  .connect:hover { opacity: 0.7; text-decoration: underline; }
  .right {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 220px;
  }
  .item {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .label {
    font-size: 16px;
    font-weight: 600;
    color: var(--ft-title, var(--ink));
  }
  .value {
    font-size: 14.5px;
    color: var(--ft-muted, var(--ink-2));
    transition: opacity 0.25s;
  }
  .value.accent { color: var(--ft-accent, var(--accent)); }
  .value:hover { opacity: 0.7; }
  .bottom {
    margin: 64px 0 0;
    font-size: 13px;
    color: var(--ft-muted, var(--ink-2));
  }
  @media (max-width: 640px) {
    .footer { padding: 48px 0 28px; }
    .grid { flex-direction: column; gap: 36px; }
    .bottom { margin-top: 44px; }
  }
</style>
