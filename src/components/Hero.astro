---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section id="hero" class="hero">
  <div class="stack">
    <p class="kicker mono" data-hero-sub>SHAW X</p>
    <p class="lede" data-hero-sub>
      AI Native Coder And Designer<br />Across Brands And Creative Products
    </p>
    <h1 class="display" data-hero-name>
      <span>An Idea</span>
      <span>And</span>
      <span>A Call</span>
    </h1>
  </div>
  <p class="scroll-hint mono" data-hero-sub>{t(lang, 'hero.scroll')} ↓</p>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 56px 24px 0;
    text-align: center;
    background:
      linear-gradient(180deg, rgba(12, 5, 4, 0.3) 0%, rgba(12, 5, 4, 0.05) 38%, rgba(12, 5, 4, 0) 60%),
      url('/about/portrait.jpg') center 30% / cover no-repeat,
      linear-gradient(180deg, #D9492A 0%, #E6562E 50%, #C8401F 100%);
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 140px;
    background: linear-gradient(180deg, transparent, var(--bg));
    pointer-events: none;
  }
  .stack {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .kicker {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.26em;
    color: rgba(246, 238, 230, 0.92);
  }
  .lede {
    margin: 18px 0 0;
    font-size: clamp(12px, 1.4vw, 15px);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.75;
    color: #F4EEE6;
  }
  .display {
    margin: clamp(28px, 5vh, 56px) 0 0;
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(58px, 13.5vw, 185px);
    line-height: 0.94;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    color: #F4F2ED;
    text-shadow: 0 3px 36px rgba(10, 4, 2, 0.28);
  }
  .display span { display: block; }
  .scroll-hint {
    position: absolute;
    bottom: 26px;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.14em;
    color: rgba(246, 238, 230, 0.8);
    z-index: 2;
  }
</style>
