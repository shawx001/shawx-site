---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section id="hero" class="hero">
  <!-- 墨韵滤镜:fractalNoise 把字的边缘晕染开 -->
  <svg class="ink-defs" width="0" height="0" aria-hidden="true">
    <filter id="inkbleed" x="-15%" y="-15%" width="130%" height="130%">
      <feTurbulence type="fractalNoise" baseFrequency="0.013 0.019" numOctaves="2" seed="6" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="13" xChannelSelector="R" yChannelSelector="G" />
    </filter>
    <filter id="inkbleed-sm" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.028 0.034" numOctaves="2" seed="3" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="5" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>

  <div class="stack">
    <div class="brand-name" data-hero-sub>
      <span class="brand-shaw">Shaw</span>
      <span class="x-wrap">
        <canvas class="x-canvas" data-particle-x aria-hidden="true"></canvas>
        <img class="x-fallback" src="/favicon.svg" alt="" aria-hidden="true" />
      </span>
    </div>
    <p class="lede" data-hero-sub>
      AI Native Coder And Designer<br />Across Brands And Creative Products
    </p>
    <h1 class="display" data-hero-name>
      <span>An Idea</span>
      <span>And</span>
      <span>A Call</span>
      <i class="drop d1" aria-hidden="true"></i>
      <i class="drop d2" aria-hidden="true"></i>
      <i class="drop d3" aria-hidden="true"></i>
      <i class="drop d4" aria-hidden="true"></i>
    </h1>
  </div>
  <p class="scroll-hint mono" data-hero-sub>{t(lang, 'hero.scroll')} ↓</p>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 56px 24px 0;
    text-align: center;
    background:
      linear-gradient(180deg, rgba(12, 5, 4, 0.3) 0%, rgba(12, 5, 4, 0.05) 38%, rgba(12, 5, 4, 0) 60%),
      url('/about/portrait.jpg') center 30% / cover no-repeat,
      linear-gradient(180deg, #D9492A 0%, #E6562E 50%, #C8401F 100%);
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 110px;
    background: linear-gradient(180deg, transparent, rgba(26, 17, 46, 0.6));
    pointer-events: none;
  }
  .stack {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .brand-name {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ink-defs { position: absolute; pointer-events: none; }
  .brand-shaw {
    font-family: var(--serif);
    font-weight: 900;
    font-size: clamp(34px, 4.4vw, 52px);
    letter-spacing: -0.01em;
    color: #F8F3E8;
    filter: url(#inkbleed-sm) drop-shadow(0 2px 18px rgba(10, 4, 2, 0.45));
  }
  .x-wrap {
    position: relative;
    width: clamp(48px, 6vw, 76px);
    aspect-ratio: 1;
    display: block;
  }
  .x-canvas {
    position: absolute;
    inset: -35%;
    width: 170%;
    height: 170%;
  }
  .x-fallback {
    display: none;
    position: absolute;
    inset: 15%;
    width: 70%;
  }
  .x-fallback.show { display: block; }
  .lede {
    margin: 18px 0 0;
    font-size: clamp(12px, 1.4vw, 15px);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.75;
    color: #F4EEE6;
  }
  .display {
    position: relative;
    margin: clamp(28px, 5vh, 56px) 0 0;
    font-family: var(--serif);
    font-weight: 900;
    font-size: clamp(60px, 14vw, 196px);
    line-height: 0.9;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #F4F2ED;
    filter: url(#inkbleed) drop-shadow(0 4px 30px rgba(10, 4, 2, 0.4));
  }
  .display span { display: block; }
  /* 墨点飞溅 */
  .drop {
    position: absolute;
    border-radius: 50%;
    background: #F4F2ED;
    filter: url(#inkbleed-sm);
    opacity: 0.82;
  }
  .d1 { width: 13px; height: 11px; top: -4%; left: 16%; }
  .d2 { width: 8px; height: 8px; top: 8%; right: 12%; opacity: 0.6; }
  .d3 { width: 16px; height: 13px; bottom: 2%; left: 6%; opacity: 0.7; }
  .d4 { width: 7px; height: 9px; bottom: 16%; right: 20%; opacity: 0.55; }
  @media (max-width: 600px) { .drop { display: none; } }
  .scroll-hint {
    position: absolute;
    bottom: 26px;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.14em;
    color: rgba(246, 238, 230, 0.8);
    z-index: 2;
  }
</style>
