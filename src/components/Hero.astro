---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section id="hero" class="hero">
  <div class="stack">
    <div class="brand-name" data-hero-sub>
      <span class="brand-shaw">Shaw</span>
      <span class="x-wrap">
        <canvas class="x-canvas" data-particle-x aria-hidden="true"></canvas>
        <img class="x-fallback" src="/favicon.svg" alt="" aria-hidden="true" />
      </span>
    </div>
    <p class="lede" data-hero-sub>
      AI Native Coder And Designer<br />Across Brands And Creative Products
    </p>
    <h1 class="display" data-hero-name>
      <span>An Idea</span>
      <span>And</span>
      <span>A Call</span>
    </h1>
  </div>
  <p class="scroll-hint mono" data-hero-sub>{t(lang, 'hero.scroll')} ↓</p>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 56px 24px 0;
    text-align: center;
    background:
      linear-gradient(180deg, rgba(12, 5, 4, 0.3) 0%, rgba(12, 5, 4, 0.05) 38%, rgba(12, 5, 4, 0) 60%),
      url('/about/portrait.jpg') center 30% / cover no-repeat,
      linear-gradient(180deg, #D9492A 0%, #E6562E 50%, #C8401F 100%);
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 110px;
    background: linear-gradient(180deg, transparent, rgba(26, 17, 46, 0.6));
    pointer-events: none;
  }
  .stack {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .brand-name {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .brand-shaw {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(30px, 4vw, 46px);
    color: #F8F3E8;
    text-shadow: 0 2px 24px rgba(10, 4, 2, 0.35);
  }
  .x-wrap {
    position: relative;
    width: clamp(48px, 6vw, 76px);
    aspect-ratio: 1;
    display: block;
  }
  .x-canvas {
    position: absolute;
    inset: -35%;
    width: 170%;
    height: 170%;
  }
  .x-fallback {
    display: none;
    position: absolute;
    inset: 15%;
    width: 70%;
  }
  .x-fallback.show { display: block; }
  .lede {
    margin: 18px 0 0;
    font-size: clamp(12px, 1.4vw, 15px);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.75;
    color: #F4EEE6;
  }
  .display {
    margin: clamp(28px, 5vh, 56px) 0 0;
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(58px, 13.5vw, 185px);
    line-height: 0.94;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    color: #F4F2ED;
    text-shadow: 0 3px 36px rgba(10, 4, 2, 0.28);
  }
  .display span { display: block; }
  .scroll-hint {
    position: absolute;
    bottom: 26px;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.14em;
    color: rgba(246, 238, 230, 0.8);
    z-index: 2;
  }
</style>
