---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section id="hero" class="hero">
  <div class="container hero-inner">
    <div class="hero-name" data-hero-name>
      <h1 class="hero-title">Shaw<span class="sr-only"> X</span></h1>
      <div class="x-wrap">
        <canvas class="x-canvas" data-particle-x aria-hidden="true"></canvas>
        <img class="x-fallback" src="/favicon.svg" alt="" aria-hidden="true" />
      </div>
    </div>
    <p class="tagline grad-text" data-hero-sub>{t(lang, 'hero.tagline')}</p>
    <p class="intro" data-hero-sub>{t(lang, 'hero.intro')}</p>
  </div>
  <p class="scroll-hint mono" data-hero-sub>{t(lang, 'hero.scroll')} ↓</p>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    padding-top: 56px;
    background:
      linear-gradient(180deg, rgba(16, 11, 34, 0.28) 0%, rgba(16, 11, 34, 0.06) 42%, rgba(16, 11, 34, 0) 70%),
      url('/bg/dusk.jpg') center 38% / cover no-repeat,
      linear-gradient(180deg, #55549A 0%, #8A6CB5 32%, #D98A63 56%, #7A5E92 78%, #4E3F70 100%);
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 180px;
    background: linear-gradient(180deg, transparent, var(--bg));
    pointer-events: none;
  }
  .hero-name {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1.6vw, 20px);
    width: max-content;
  }
  .hero-title {
    font-size: clamp(56px, 11vw, 130px);
    letter-spacing: -0.02em;
    color: #F8F3E8;
    text-shadow: 0 2px 28px rgba(20, 12, 44, 0.4);
  }
  .x-wrap {
    position: relative;
    width: clamp(120px, 16vw, 220px);
    aspect-ratio: 1;
  }
  .x-canvas {
    position: absolute;
    inset: -35%;
    width: 170%;
    height: 170%;
  }
  .x-fallback {
    display: none;
    position: absolute;
    inset: 15%;
    width: 70%;
  }
  .x-fallback.show { display: block; }
  .tagline {
    margin: 22px 0 0;
    font-family: var(--serif);
    font-size: clamp(26px, 3.4vw, 44px);
    font-weight: 500;
    letter-spacing: 0.01em;
    width: max-content;
  }
  .hero .tagline.grad-text {
    background: linear-gradient(92deg, #A8CCF5, #CDB0F5 45%, #F5AFC9 75%, #F8BC9E);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .intro {
    margin: 14px 0 0;
    max-width: 520px;
    color: rgba(248, 243, 232, 0.9);
    text-shadow: 0 1px 18px rgba(20, 12, 44, 0.35);
  }
  .scroll-hint {
    position: absolute;
    bottom: 26px;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.14em;
    color: rgba(248, 243, 232, 0.8);
    z-index: 2;
  }
</style>
