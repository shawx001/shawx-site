---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const isZh = lang === 'zh';

const riskCurve = [
  { cap: '0.25%', zero: 14, sft: 31, zoom: 44, full: 55 },
  { cap: '0.5%', zero: 22, sft: 41, zoom: 55, full: 64 },
  { cap: '0.75%', zero: 29, sft: 47, zoom: 61, full: 70 },
  { cap: '1%', zero: 34, sft: 52, zoom: 66, full: 73.5 },
  { cap: '1.5%', zero: 43, sft: 60, zoom: 73, full: 80 },
  { cap: '2%', zero: 51, sft: 66, zoom: 78, full: 85 },
  { cap: '3%', zero: 61, sft: 74, zoom: 84, full: 90 },
];

const xLeft = 40;
const xRight = 398;
const yTop = 20;
const yBottom = 204;
const plotW = xRight - xLeft;
const plotH = yBottom - yTop;

const caps = riskCurve.map((row) => parseFloat(row.cap));
const xAt = (i: number) => xLeft + ((caps[i] - caps[0]) / (caps[caps.length - 1] - caps[0])) * plotW;
const yAt = (v: number) => +(yBottom - (v / 100) * plotH).toFixed(1);

const poly = (key: 'zero' | 'sft' | 'zoom' | 'full') =>
  riskCurve.map((d, i) => `${xAt(i)},${yAt(d[key])}`).join(' ');

const yTicks = [0, 25, 50, 75, 100];
const cap1X = xAt(3);
const fullAt1Y = yAt(73.5);

const failures = [
  {
    en: 'OCR 0/O, 1/I & Decimal',
    zh: 'OCR 0/O、1/I 与小数点',
    zero: 24,
    sft: 13,
    zoom: 4,
    full: 2,
  },
  {
    en: 'Cross-Page Row Shift',
    zh: '跨页表格错行',
    zero: 18,
    sft: 10,
    zoom: 4,
    full: 3,
  },
  {
    en: 'Footnote / Trust Omission',
    zh: '脚注与信托漏读',
    zero: 16,
    sft: 9,
    zoom: 5,
    full: 3,
  },
  {
    en: 'Temporal Superseding',
    zh: '历史版本覆盖',
    zero: 15,
    sft: 8,
    zoom: 3,
    full: 1,
  },
  {
    en: 'Homonym False-Merge',
    zh: '同名实体误合并',
    zero: 14,
    sft: 11,
    zoom: 8,
    full: 2,
  },
  {
    en: 'Silent Fabrication',
    zh: '无依据静默编造',
    zero: 13,
    sft: 9,
    zoom: 5,
    full: 1,
  },
];

const maxErr = 24;
const pct = (v: number) => `${((v / maxErr) * 100).toFixed(1)}%`;
---

<div class="charts-grid" id="benchmark-charts">
  <!-- Chart 1: Risk–Coverage Curve -->
  <div class="chart-card risk-card">
    <div class="ch-head">
      <div>
        <p class="ch-kicker mono">
          {isZh ? '风险–覆盖率曲线' : 'Risk–coverage curve'}
        </p>
        <h3>{isZh ? '不同误合并红线下的直通率（STP）' : 'Straight-through rate vs. mis-merge cap α'}</h3>
      </div>
    </div>

    <div class="ch-legend mono" aria-hidden="true">
      <span class="lg"><i class="sw sw-full"></i>{isZh ? '完整版 (+DPO)' : 'Full (+DPO)'}</span>
      <span class="lg"><i class="sw sw-zoom"></i>{isZh ? '+放大/校验' : '+Zoom/Verif'}</span>
      <span class="lg"><i class="sw sw-sft"></i>OCR+SFT</span>
      <span class="lg"><i class="sw sw-zero"></i>{isZh ? '零样本' : 'Zero-Shot'}</span>
    </div>

    <svg
      class="rc-svg"
      viewBox="0 0 420 252"
      role="img"
      aria-label={isZh
        ? '风险覆盖率曲线：在 1% 误合并红线下，直通率从零样本 34% 提升至完整版 73.5%'
        : 'Risk-coverage curve: at a 1% mis-merge cap, straight-through rate rises from 34% zero-shot to 73.5% full system'}
    >
      {/* Horizontal gridlines + Y labels */}
      {yTicks.map((t) => (
        <g>
          <line
            x1={xLeft}
            x2={xRight}
            y1={yAt(t)}
            y2={yAt(t)}
            stroke="var(--grid)"
            stroke-width="1"
            stroke-dasharray={t === 0 ? undefined : '3 3'}
          />
          <text
            x={xLeft - 7}
            y={yAt(t) + 3.5}
            text-anchor="end"
            class="ax-tick"
          >{t}%</text>
        </g>
      ))}

      <polygon points={`${xLeft},${yBottom} ${poly('full')} ${xRight},${yBottom}`} fill="url(#risk-wash)" />
      <defs>
        <linearGradient id="risk-wash" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="var(--full)" stop-opacity=".13" />
          <stop offset="1" stop-color="var(--full)" stop-opacity="0" />
        </linearGradient>
      </defs>
      {/* 1% compliance redline */}
      <line
        x1={cap1X}
        x2={cap1X}
        y1={yTop - 4}
        y2={yBottom}
        stroke="var(--full)"
        stroke-width="1.2"
        stroke-dasharray="4 3"
        opacity="0.7"
      />
      <text x={cap1X + 5} y={yTop - 5} class="cap-lbl">
        {isZh ? 'α ≤ 1% 红线' : 'α ≤ 1% cap'}
      </text>

      {/* Series lines */}
      <polyline fill="none" stroke="var(--zero)" stroke-width="1.5" stroke-dasharray="4 3" points={poly('zero')} />
      <polyline fill="none" stroke="var(--sft)" stroke-width="1.8" points={poly('sft')} />
      <polyline fill="none" stroke="var(--zoom)" stroke-width="2" points={poly('zoom')} />
      <polyline fill="none" stroke="var(--full)" stroke-width="3" points={poly('full')} />

      {/* Data points */}
      {riskCurve.map((d, i) => (
        <g>
          <circle cx={xAt(i)} cy={yAt(d.zero)} r="2.2" fill="var(--zero)" />
          <circle cx={xAt(i)} cy={yAt(d.sft)} r="2.4" fill="var(--sft)" />
          <circle cx={xAt(i)} cy={yAt(d.zoom)} r="2.6" fill="var(--zoom)" />
          <circle cx={xAt(i)} cy={yAt(d.full)} r="3.4" fill="var(--plot-bg)" stroke="var(--full)" stroke-width="2" />
        </g>
      ))}

      {/* Callout at 1% cap */}
      <circle cx={cap1X} cy={fullAt1Y} r="7" fill="var(--full)" fill-opacity=".25" />
      <circle cx={cap1X} cy={fullAt1Y} r="4" fill="var(--full)" stroke="var(--plot-bg)" stroke-width="1.5" />
      <g transform={`translate(${cap1X - 55} ${fullAt1Y - 26})`}>
        <rect width="50" height="20" rx="5" fill="var(--full)" />
        <text x="25" y="14" text-anchor="middle" class="callout">73.5%</text>
      </g>

      {/* X ticks */}
      {riskCurve.map((d, i) => (
        <text x={xAt(i)} y={yBottom + 16} text-anchor="middle" class:list={['ax-tick', { 'tick-stagger': i === 1 || i === 3 }]}>
          {d.cap}
        </text>
      ))}
      <text x={(xLeft + xRight) / 2} y={247} text-anchor="middle" class="ax-title">
        {isZh ? '允许误合并率上限 α' : 'Allowed mis-merge risk cap α'}
      </text>
    </svg>

    <p class="ch-cap mono">
      {isZh ? '纵轴为免转人工直通率' : 'Y-axis: automated STP rate'}
    </p>
  </div>

  <!-- Chart 2: Failure Mode Attribution -->
  <div class="chart-card failure-card">
    <div class="ch-head">
      <div>
        <p class="ch-kicker mono">
          {isZh ? '6 类坏案例归因' : 'Failure attribution'}
        </p>
        <h3>{isZh ? '各阶段消除的典型错误案数' : 'Error cases reduced per pipeline stage'}</h3>
      </div>
    </div>

    <div class="ch-legend mono" aria-hidden="true">
      <span class="lg"><i class="sw sw-zero-bar"></i>{isZh ? '零样本' : 'Zero-Shot'}</span>
      <span class="lg"><i class="sw sw-sft"></i>OCR+SFT</span>
      <span class="lg"><i class="sw sw-zoom"></i>{isZh ? '+放大/校验' : '+Zoom/Verif'}</span>
      <span class="lg"><i class="sw sw-full"></i>{isZh ? '完整版' : 'Full'}</span>
    </div>

    <div class="fa-list" role="img" aria-label={isZh
      ? '六类典型错误案数从零样本到完整版的降幅：OCR 数字错误 24 降至 2、跨页错行 18 降至 3、脚注漏读 16 降至 3、版本覆盖 15 降至 1、同名误合并 14 降至 2、无依据编造 13 降至 1'
      : 'Error reductions across six failure modes from zero-shot to full system: OCR digits 24 to 2, cross-page shift 18 to 3, footnote omission 16 to 3, temporal superseding 15 to 1, homonym false-merge 14 to 2, silent fabrication 13 to 1'}>
      {failures.map((f) => (
        <div class="fa-row">
          <div class="fa-top">
            <span class="fa-name">{isZh ? f.zh : f.en}</span>
            <span class="fa-delta mono">{f.zero} → <strong>{f.full}</strong></span>
          </div>
          <div class="fa-bars">
            <span class="fb fb-zero" style={`width:${pct(f.zero)}`}></span>
            <span class="fb fb-sft" style={`width:${pct(f.sft)}`}></span>
            <span class="fb fb-zoom" style={`width:${pct(f.zoom)}`}></span>
            <span class="fb fb-full" style={`width:${pct(f.full)}`}></span>
          </div>
        </div>
      ))}
    </div>

    <p class="ch-cap mono">
      {isZh ? '单位：测试集错误案数' : 'Error case counts on holdout'}
    </p>
  </div>
</div>

<style>
  .charts-grid {
    display: grid;
    gap: 18px;
    margin-top: 28px;
  }
  .chart-card {
    --full: #af442a;
    --zoom: #35776e;
    --sft: #9b742e;
    --zero: #81786a;
    min-width: 0;
    padding: clamp(18px, 3.4vw, 30px);
    border: 1px solid var(--hairline);
    border-radius: 18px;
    background: #fffcf6;
    color: var(--ink);
  }
  .risk-card {
    --plot-bg: #242020;
    --full: #ff9c76;
    --zoom: #91c4b8;
    --sft: #d7b673;
    --zero: #a8a3a1;
    --grid: #554a46;
    display: grid;
    grid-template-columns: minmax(145px, 0.8fr) minmax(0, 2fr);
    grid-template-areas: "title plot" "legend plot" "caption plot";
    grid-template-rows: auto 1fr auto;
    gap: 16px 26px;
    background: radial-gradient(ellipse at 90% 0%, #372b29, transparent 66%), var(--plot-bg);
    border-color: var(--plot-bg);
    color: #fff5e8;
  }
  .ch-kicker {
    margin: 0;
    color: var(--full);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .chart-card h3 {
    margin: 7px 0 0;
    font-size: clamp(20px, 2.4vw, 25px);
    line-height: 1.25;
    text-wrap: balance;
  }
  .ch-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 16px;
    font-size: 11px;
    line-height: 1.65;
  }
  .risk-card .ch-head { grid-area: title; }
  .risk-card .ch-legend {
    grid-area: legend;
    align-self: start;
    flex-direction: column;
    color: #dfd6cd;
  }
  .lg { display: inline-flex; align-items: center; gap: 7px; }
  .sw { width: 15px; height: 3px; border-radius: 3px; }
  .sw-full, .fb-full { background: var(--full); }
  .sw-zoom, .fb-zoom { background: var(--zoom); }
  .sw-sft, .fb-sft { background: var(--sft); }
  .sw-zero-bar, .fb-zero { background: var(--zero); }
  .sw-zero { height: 0; border-top: 2px dashed var(--zero); border-radius: 0; }
  .rc-svg { grid-area: plot; width: 100%; height: auto; align-self: center; display: block; }
  .ax-tick, .ax-title, .cap-lbl, .callout { font-family: var(--mono); }
  .ax-tick, .ax-title { fill: #d5ccc2; font-size: 10px; }
  .cap-lbl { fill: var(--full); font-size: 10px; }
  .callout { fill: var(--plot-bg); font-size: 12px; font-weight: 700; }
  .failure-card .ch-legend { margin: 14px 0 20px; color: var(--ink-2); }
  .fa-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px 22px;
  }
  .fa-row { min-width: 0; padding-top: 10px; border-top: 1px solid var(--hairline); }
  .fa-top { display: flex; flex-direction: column; gap: 3px; }
  .fa-name { font-size: 13px; line-height: 1.5; }
  .fa-delta { font-size: 19px; line-height: 1.5; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .fa-delta strong { color: var(--full); font-weight: 650; }
  .fa-bars {
    display: grid;
    gap: 3px;
    margin-top: 6px;
    background: repeating-linear-gradient(to right, #eae3d8 0 1px, transparent 1px 25%);
  }
  .fb { display: block; height: 4px; border-radius: 0 3px 3px 0; }
  .ch-cap { margin: 18px 0 0; color: var(--ink-2); font-size: 11px; }
  .risk-card .ch-cap { grid-area: caption; margin: 0; color: #c5bab4; }
  @media (max-width: 700px) {
    .risk-card {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "title" "legend" "plot" "caption";
      grid-template-rows: auto;
      gap: 12px;
    }
    .risk-card .ch-legend { flex-direction: row; }
    .fa-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 440px) {
    .fa-list { grid-template-columns: minmax(0, 1fr); gap: 9px; }
    .fa-row { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 12px; }
    .fa-bars { margin: 0; }
    .ax-tick, .ax-title, .cap-lbl { font-size: 12px; }
    .tick-stagger { transform: translateY(9px); }
  }
</style>
